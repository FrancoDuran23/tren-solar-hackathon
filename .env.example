# Reenvío opcional del form de entrega. La entrega se guarda en Neon
# aunque esto quede vacío. Formspree (https://formspree.io/f/xxxx) o Apps Script.
ENTREGA_WEBHOOK_URL=

# Auth con Google + perfil + ranking (T16–T18). Todas opcionales: sin ellas el build pasa
# y el ingreso responde 503. Ver docs/auth-ranking.md.
# Neon: connection string pooled (host con -pooler), con sslmode=require.
DATABASE_URL=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Origen canónico. En local dejalo vacío (se infiere localhost). En prod:
# https://tren-solar-hackathon.vercel.app
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Protege POST /api/admin/ranking. openssl rand -base64 32
ADMIN_SECRET=
