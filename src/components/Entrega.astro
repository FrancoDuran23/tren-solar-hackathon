---
import { copy } from '../content/copy';
import { dates } from '../content/dates';
import { TRACTION_TYPES } from '../lib/entrega';
import { entregaEditsOpen } from '../lib/entrega-window';

const editsOpen = entregaEditsOpen();
const { auth, entrega } = copy;
---

<section
  class="ent"
  id="entrega"
  aria-labelledby="ent-title"
  data-deadline={dates.buildEndIso}
  data-locked={editsOpen ? 'false' : 'true'}
>
  <div class="wrap">
    <h2 id="ent-title">Entregá tu proyecto.</h2>
    <p class="lead">{entrega.lead}</p>
    <p class="window" id="entrega-window">{entrega.window}</p>
    <p class="banner mono" id="entrega-locked" role="status" hidden={editsOpen}>{entrega.locked}</p>

    <p class="banner mono" id="entrega-auth">
      <span id="entrega-auth-text">{auth.entregaNeedLogin}</span>
      <button type="button" class="auth-btn" id="entrega-signin">{auth.signIn}</button>
      <a href="#perfil" id="entrega-auth-link" hidden>Completar perfil</a>
    </p>

    <div class="card">
      <form id="entrega-form" novalidate>
        <fieldset disabled>
          <legend class="sr">Datos de la entrega</legend>

          <div class="field" data-f="proyecto">
            <label for="f-proyecto" class="mono">Nombre del proyecto</label>
            <input id="f-proyecto" name="proyecto" type="text" required maxlength="60" autocomplete="off" aria-describedby="e-proyecto" />
            <p class="err" id="e-proyecto" role="alert"></p>
          </div>

          <div class="field" data-f="responsable">
            <label for="f-responsable" class="mono">Equipo / responsable</label>
            <input id="f-responsable" name="responsable" type="text" required maxlength="80" autocomplete="name" aria-describedby="h-responsable e-responsable" />
            <p class="help" id="h-responsable">Nombre y apellido de quien entrega.</p>
            <p class="err" id="e-responsable" role="alert"></p>
          </div>

          <div class="field" data-f="email">
            <label for="f-email" class="mono">Email de contacto</label>
            <input id="f-email" name="email" type="email" required maxlength="120" autocomplete="email" aria-describedby="h-email e-email" />
            <p class="help" id="h-email">Si entrás con Google, queda el email de esa cuenta.</p>
            <p class="err" id="e-email" role="alert"></p>
          </div>

          <div class="field check" data-f="jujuy">
            <label class="chk">
              <input id="f-jujuy" name="jujuy" type="checkbox" required aria-describedby="h-jujuy e-jujuy" />
              <span>Vivo o resido en Jujuy</span>
            </label>
            <p class="help" id="h-jujuy">{copy.profile.jujuyHelp}</p>
            <p class="err" id="e-jujuy" role="alert"></p>
          </div>

          <div class="field" data-f="localidad">
            <label for="f-localidad" class="mono">Localidad</label>
            <input id="f-localidad" name="localidad" type="text" maxlength="80" autocomplete="address-level2" aria-describedby="e-localidad" />
            <p class="err" id="e-localidad" role="alert"></p>
          </div>

          <div class="field" data-f="repo">
            <label for="f-repo" class="mono">URL del repo</label>
            <input id="f-repo" name="repo" type="url" required maxlength="300" placeholder="https://github.com/…" aria-describedby="h-repo e-repo" />
            <p class="help" id="h-repo">Público, o con acceso para el jurado.</p>
            <p class="err" id="e-repo" role="alert"></p>
          </div>

          <div class="field" data-f="demo">
            <label for="f-demo" class="mono">URL de la demo</label>
            <input id="f-demo" name="demo" type="url" required maxlength="300" placeholder="https://…" aria-describedby="h-demo e-demo" />
            <p class="help" id="h-demo">Deploy navegable. Si es app móvil, link a TestFlight/APK.</p>
            <p class="err" id="e-demo" role="alert"></p>
          </div>

          <div class="field" data-f="video">
            <label for="f-video" class="mono">URL del video</label>
            <input id="f-video" name="video" type="url" required maxlength="300" placeholder="https://youtu.be/…" aria-describedby="h-video e-video" />
            <p class="help" id="h-video">Máx. 3 minutos. Mostrá el producto funcionando.</p>
            <p class="err" id="e-video" role="alert"></p>
          </div>

          <div class="trac">
            <p class="mono trac-t">Tracción <span class="opt">(opcional)</span></p>
            <div class="trac-grid">
              <div class="field" data-f="tractionTipo">
                <label for="f-tractionTipo" class="mono">Tipo</label>
                <select id="f-tractionTipo" name="tractionTipo" aria-describedby="e-tractionTipo">
                  <option value="">— sin tracción —</option>
                  {TRACTION_TYPES.map((t) => <option value={t.value}>{t.label}</option>)}
                </select>
                <p class="err" id="e-tractionTipo" role="alert"></p>
              </div>
              <div class="field" data-f="tractionNumero">
                <label for="f-tractionNumero" class="mono">Número</label>
                <input id="f-tractionNumero" name="tractionNumero" type="number" min="0" step="any" inputmode="decimal" aria-describedby="e-tractionNumero" />
                <p class="err" id="e-tractionNumero" role="alert"></p>
              </div>
            </div>
            <div class="field" data-f="tractionEvidencia">
              <label for="f-tractionEvidencia" class="mono">Evidencia (URL)</label>
              <input id="f-tractionEvidencia" name="tractionEvidencia" type="url" maxlength="300" placeholder="https://…" aria-describedby="h-tractionEvidencia e-tractionEvidencia" />
              <p class="help" id="h-tractionEvidencia">Link que respalde el número. Requerido si elegiste un tipo.</p>
              <p class="err" id="e-tractionEvidencia" role="alert"></p>
            </div>
          </div>

          <div class="field" data-f="descripcion">
            <label for="f-descripcion" class="mono">Descripción corta <span class="opt">(opcional)</span></label>
            <textarea id="f-descripcion" name="descripcion" rows="3" maxlength="280" aria-describedby="h-descripcion e-descripcion"></textarea>
            <p class="help" id="h-descripcion">Qué problema resuelve y para quién. <span id="count" class="mono">0/280</span></p>
            <p class="err" id="e-descripcion" role="alert"></p>
          </div>

          <div class="hp" aria-hidden="true">
            <label>No completar <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>

          <p class="privacy">
            <strong>Privacidad:</strong> te pedimos solo estos datos. Si entrás con Google, la entrega queda atada a ese email.
            Los usamos para evaluar tu proyecto y contactarte; los ven la organización de jujuy.dev y el jurado. Sin tracking de terceros.
          </p>

          <button type="submit" class="btn mono" id="submit">
            <span class="lbl">{entrega.submit}</span>
            <span class="spin" aria-hidden="true">[ // ]</span>
          </button>
        </fieldset>
      </form>

      <aside class="stub mono" aria-live="polite" aria-label="Comprobante">
        <p class="stub-h">COMPROBANTE</p>
        <dl>
          <dt>PROYECTO</dt><dd id="s-proyecto">———</dd>
          <dt>RESPONSABLE</dt><dd id="s-responsable">———</dd>
          <dt>LOCALIDAD</dt><dd id="s-localidad">———</dd>
        </dl>
        <p class="stub-id" id="s-id">JDV-2026-····</p>
      </aside>
    </div>

    <div class="toast mono" id="toast" role="alert" hidden>
      No pudimos despachar tu proyecto. Probá de nuevo en un minuto.
    </div>

    <div class="receipt" id="receipt" hidden>
      <div class="paper mono">
        <p class="paper-h">PROYECTO A BORDO</p>
        <p class="paper-id" id="r-id"></p>
        <p id="r-name"></p>
        <p id="r-at"></p>
        <svg class="bars" viewBox="0 0 120 24" aria-hidden="true"><path d="M2 0h2v24H2zM7 0h1v24H7zM11 0h3v24h-3zM17 0h1v24h-1zM21 0h2v24h-2zM26 0h4v24h-4zM33 0h1v24h-1zM37 0h2v24h-2zM42 0h1v24h-1zM46 0h3v24h-3zM52 0h1v24h-1zM56 0h2v24h-2zM61 0h4v24h-4zM68 0h1v24h-1zM72 0h2v24h-2zM77 0h1v24h-1zM81 0h3v24h-3zM87 0h2v24h-2zM92 0h1v24h-1zM96 0h4v24h-4zM103 0h2v24h-2zM108 0h1v24h-1zM112 0h3v24h-3z" fill="currentColor"/></svg>
      </div>
      <p class="ok-msg">{entrega.updated} Guardá tu Hacker ID.</p>
      <button type="button" class="btn mono" id="download">Descargar comprobante</button>
    </div>
  </div>
</section>

<script>
  import { copy } from '../content/copy';
  import { loadMe, onAuthChange, signInWithGoogle } from '../lib/auth-client';
  import { FIELDS, validateField, validateEntrega, type EntregaField, type EntregaInput } from '../lib/entrega';
  import type { MeResponse } from '../lib/me';

  const root = document.getElementById('entrega')!;
  const form = document.getElementById('entrega-form') as HTMLFormElement;
  const deadlineMs = Date.parse(root.dataset.deadline ?? '');
  const editsOpen = () => Number.isFinite(deadlineMs) && Date.now() <= deadlineMs;
  const $ = (id: string) => document.getElementById(id)!;
  const fieldEl = (f: EntregaField) => form.querySelector<HTMLElement>(`[data-f="${f}"]`)!;
  const ctl = (f: EntregaField) => form.elements.namedItem(f) as HTMLInputElement;

  function read(): EntregaInput {
    const o: Record<string, string | boolean> = {};
    for (const f of FIELDS) o[f] = f === 'jujuy' ? ctl(f).checked : ctl(f).value.trim();
    return o as unknown as EntregaInput;
  }

  function show(f: EntregaField, err: string | null, touched = true) {
    const el = fieldEl(f);
    const c = ctl(f);
    $(`e-${f}`).textContent = err ?? '';
    el.classList.toggle('bad', !!err);
    const filled = f === 'jujuy' ? c.checked : c.value.trim() !== '';
    el.classList.toggle('ok', !err && touched && filled);
    c.setAttribute('aria-invalid', err ? 'true' : 'false');
  }

  function checkField(f: EntregaField) {
    show(f, validateField(f, read()));
    // dependientes
    if (f === 'jujuy') show('localidad', touchedSet.has('localidad') ? validateField('localidad', read()) : null, touchedSet.has('localidad'));
    if (f === 'tractionTipo' && touchedSet.has('tractionEvidencia')) show('tractionEvidencia', validateField('tractionEvidencia', read()));
  }

  const touchedSet = new Set<EntregaField>();
  for (const f of FIELDS) {
    const c = ctl(f);
    const ev = f === 'jujuy' || f === 'tractionTipo' ? 'change' : 'blur';
    c.addEventListener(ev, () => { touchedSet.add(f); checkField(f); });
    if (ev === 'blur') c.addEventListener('input', () => { if (touchedSet.has(f)) checkField(f); });
    c.addEventListener('input', livePreview);
    c.addEventListener('change', livePreview);
  }

  function livePreview() {
    const d = read();
    $('s-proyecto').textContent = d.proyecto || '———';
    $('s-responsable').textContent = d.responsable || '———';
    $('s-localidad').textContent = d.localidad || '———';
    $('count').textContent = `${ctl('descripcion').value.length}/280`;
  }

  const submit = $('submit') as HTMLButtonElement;
  const toast = $('toast');
  const fieldset = form.querySelector('fieldset')!;
  const authBanner = $('entrega-auth');
  const authText = $('entrega-auth-text');
  const authLink = $('entrega-auth-link') as HTMLAnchorElement;
  const signInBtn = $('entrega-signin') as HTMLButtonElement;
  const lockedBanner = $('entrega-locked');
  const defaultToast = toast.textContent ?? '';
  let sending = false;
  let last: { id: string; name: string; at: string } | null = null;
  let gate: 'unknown' | 'open' | 'blocked' = 'unknown';
  let gateMessage = '';
  let entregaPrefilled = false;

  function applyGate(me: MeResponse) {
    const email = ctl('email');
    if (!editsOpen()) {
      gate = 'blocked';
      gateMessage = copy.entrega.locked;
      fieldset.disabled = true;
      authBanner.hidden = true;
      lockedBanner.hidden = false;
      return;
    }
    lockedBanner.hidden = true;
    const block = (message: string, opts: { signIn?: boolean; profile?: boolean } = {}) => {
      gate = 'blocked';
      gateMessage = message;
      fieldset.disabled = true;
      authBanner.hidden = false;
      authText.textContent = message;
      authLink.hidden = !opts.profile;
      signInBtn.hidden = !opts.signIn;
    };
    if (me.error) {
      block(me.error);
      return;
    }
    if (!me.user) {
      email.readOnly = false;
      entregaPrefilled = false;
      block(copy.auth.entregaNeedLogin, { signIn: true });
      return;
    }
    email.value = me.user.email;
    email.readOnly = true;
    signInBtn.hidden = true;
    if (!entregaPrefilled && me.profile) {
      if (ctl('responsable').value.trim() === '') ctl('responsable').value = me.profile.fullName;
      if (me.profile.livesInJujuy) ctl('jujuy').checked = true;
      if (ctl('localidad').value.trim() === '') ctl('localidad').value = me.profile.localidad;
      entregaPrefilled = true;
      livePreview();
    }
    if (me.profile?.completeness === 100) {
      gate = 'open';
      fieldset.disabled = false;
      authBanner.hidden = true;
      return;
    }
    block(`${copy.auth.entregaNeedProfile} Ahora está al ${me.profile?.completeness ?? 0}%.`, { profile: true });
  }

  signInBtn.addEventListener('click', () => {
    void loadMe().then(async (me) => {
      if (!me.configured) {
        authText.textContent = copy.auth.unavailable;
        return;
      }
      signInBtn.disabled = true;
      const err = await signInWithGoogle();
      if (err) {
        authText.textContent = err;
        signInBtn.disabled = false;
      }
    });
  });

  onAuthChange(() => {
    void loadMe().then(applyGate);
  });
  void loadMe().then(applyGate);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!editsOpen() || sending) return;
    if (gate === 'unknown') {
      applyGate(await loadMe());
    }
    if (gate === 'blocked') {
      toast.textContent = gateMessage;
      toast.hidden = false;
      return;
    }
    toast.textContent = defaultToast;
    toast.hidden = true;
    const d = read();
    const errors = validateEntrega(d);
    for (const f of FIELDS) { touchedSet.add(f); show(f, errors[f] ?? null); }
    const first = FIELDS.find((f) => errors[f]);
    if (first) { ctl(first).focus(); return; }

    sending = true;
    submit.disabled = true;
    form.classList.add('sending');
    try {
      const res = await fetch('/api/entrega', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ ...d, website: (form.elements.namedItem('website') as HTMLInputElement).value }),
      });
      const body = await res.json().catch(() => ({}));
      if (res.status === 422 && body.errors) {
        for (const f of FIELDS) show(f, body.errors[f] ?? null);
      } else if (res.ok && body.ok) {
        last = { id: body.hackerId, name: d.proyecto, at: body.at };
        $('s-id').textContent = body.hackerId;
        $('r-id').textContent = body.hackerId;
        $('r-name').textContent = d.proyecto;
        $('r-at').textContent = new Date(body.at).toLocaleString('es-AR');
        root.classList.add('done');
        $('receipt').hidden = false;
        $('receipt').focus?.();
        $('receipt').scrollIntoView({ block: 'center' });
        form.hidden = true;
        return;
      } else {
        if (typeof body.error === 'string' && body.error) toast.textContent = body.error;
        toast.hidden = false; // datos intactos en el form
      }
    } catch {
      toast.hidden = false;
    } finally {
      sending = false;
      submit.disabled = !editsOpen();
      form.classList.remove('sending');
    }
  });

  $('download').addEventListener('click', () => {
    if (!last) return;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const html = `<!doctype html><meta charset="utf-8"><title>Comprobante ${esc(last.id)}</title><body style="font-family:monospace;background:#f2f0ea;color:#0e0f12;max-width:420px;margin:40px auto;padding:24px;border:2px dashed #0e0f12"><h1>PROYECTO A BORDO</h1><h2>${esc(last.id)}</h2><p>${esc(last.name)}</p><p>${esc(new Date(last.at).toLocaleString('es-AR'))}</p><p>jujuy.dev · Hackatón Tren Solar</p></body>`;
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([html], { type: 'text/html' }));
    a.download = `comprobante-${last.id}.html`;
    a.click();
    URL.revokeObjectURL(a.href);
  });
</script>

<style>
  .ent { background: var(--cosmos-950); padding: var(--sp-16) 0; border-top: 1px solid var(--edge); }
  .wrap { max-width: var(--container-max); margin: 0 auto; padding: 0 var(--gutter); }
  h2 { font-family: var(--font-display); font-weight: 900; font-size: var(--fs-h2); line-height: var(--lh-h2); margin: 0 0 var(--sp-4); }
  .lead { color: var(--text-muted); font-size: var(--fs-lead); line-height: var(--lh-lead); max-width: 62ch; margin: 0; }
  .window { color: var(--white); font-size: var(--fs-lead); line-height: var(--lh-lead); max-width: 62ch; margin: var(--sp-4) 0 var(--sp-8); }
  #entrega-locked[hidden] { display: none; }
  .mono { font-family: var(--font-mono); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .banner { display: inline-block; border: 1px solid var(--orange-500); color: var(--orange-300); border-radius: var(--r-sm); padding: var(--sp-2) var(--sp-4); font-size: var(--fs-small); margin: 0 0 var(--sp-6); }
  .card { display: grid; grid-template-columns: 1fr 260px; gap: var(--sp-6); background: linear-gradient(180deg, #11151f, #0b0e16); border: 1px solid var(--edge); border-radius: 0; clip-path: polygon(14px 0, calc(100% - 14px) 0, 100% 14px, 100% calc(100% - 14px), calc(100% - 14px) 100%, 14px 100%, 0 calc(100% - 14px), 0 14px); padding: var(--sp-8); }
  fieldset { border: 0; margin: 0; padding: 0; display: grid; gap: var(--sp-4); min-width: 0; }
  fieldset:disabled input, fieldset:disabled select, fieldset:disabled textarea, fieldset:disabled .btn { opacity: 0.55; cursor: not-allowed; }
  fieldset:disabled .chk { cursor: not-allowed; }
  .field { position: relative; display: grid; gap: 6px; }
  label.mono { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-200); font-weight: 700; }
  .opt { text-transform: none; opacity: 0.7; }
  input[type='text'], input[type='email'], input[type='url'], input[type='number'], select, textarea {
    width: 100%; box-sizing: border-box; min-height: 48px; padding: 0 var(--sp-4);
    background: var(--cosmos-950); color: var(--white); border: 1px solid var(--edge); border-radius: 0;
    font: inherit;
  }
  textarea { padding-block: var(--sp-3); resize: vertical; }
  input::placeholder, textarea::placeholder { color: rgba(255,255,255,0.4); }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: none; border-color: var(--orange-500); box-shadow: 0 0 0 3px rgba(255, 90, 31, 0.35); }
  input[readonly] { opacity: 0.8; }
  #entrega-auth:not([hidden]) { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-3); }
  #entrega-auth a { color: var(--orange-300); }
  #entrega-auth[hidden] { display: none; }
  .auth-btn {
    min-height: 36px;
    padding: 0 12px;
    border: 0;
    background: var(--orange-500);
    color: var(--cosmos-950);
    font: 700 13px/1 var(--font-text);
    cursor: pointer;
  }
  .auth-btn:hover:not(:disabled) { background: var(--orange-400); }
  .auth-btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .field.bad input:not([type='checkbox']), .field.bad select, .field.bad textarea { border-color: var(--error); }
  .field.ok input:not([type='checkbox']), .field.ok select, .field.ok textarea { border-color: var(--success); }
  .field.ok:not(.check)::after { content: '✓'; position: absolute; right: 14px; bottom: 12px; color: var(--success); pointer-events: none; }
  .field.ok:has(.help):not(.check)::after { bottom: calc(1.5em + 18px); }
  .field.ok:has(textarea)::after, .field.ok:has(select)::after { display: none; }
  .help { margin: 0; color: var(--text-muted); font-size: var(--fs-small); }
  .err { margin: 0; color: var(--error); font-size: var(--fs-small); }
  .err:not(:empty)::before { content: '⚠ '; }
  .chk { display: flex; gap: var(--sp-3); align-items: center; font-weight: 600; cursor: pointer; }
  .chk input { width: 22px; height: 22px; accent-color: var(--orange-500); }
  .trac { display: grid; gap: var(--sp-3); padding: var(--sp-4); border: 1px dashed rgba(255,255,255,0.28); border-radius: var(--r-sm); }
  .trac-t { margin: 0; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-200); font-weight: 700; }
  .trac-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .privacy { margin: 0; color: var(--text-muted); font-size: var(--fs-small); line-height: var(--lh-small); }
  .btn {
    justify-self: start; min-height: 48px; padding: 0 var(--sp-6); border: 0; border-radius: var(--r-sm);
    background: var(--orange-500); color: var(--cosmos-950); font-weight: 700; border-radius: 0; clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%); font-size: var(--fs-small); cursor: pointer;
  }
  .btn:hover:not(:disabled) { background: var(--orange-400); }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .btn:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .spin { display: none; }
  .sending .lbl { display: none; }
  .sending .spin { display: inline; animation: blink 0.9s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0.3; } }
