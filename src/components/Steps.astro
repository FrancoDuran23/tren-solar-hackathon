---
import { copy } from '../content/copy';
const { steps } = copy;

/* Iconos lineales (ticket / llave / tren), 2px, estilo poster. Reemplazan los emoji del copy. */
const icons = [
  `<path d="M3 8a2 2 0 0 0 2-2V5h18v1a2 2 0 0 0 0 4v0a2 2 0 0 0 0 4v0a2 2 0 0 0 0 4v1H5v-1a2 2 0 0 0-2-2z"/><path d="M11 5v14" stroke-dasharray="2 3"/>`,
  `<path d="M14.5 6.5a4 4 0 0 0-5.3 5.3L3 18l3 3 6.2-6.2a4 4 0 0 0 5.3-5.3L15 12l-3-3z"/>`,
  `<rect x="4" y="3" width="16" height="14" rx="3"/><path d="M4 11h16M8 21l-2 0M16 21l2 0M7 17l-1 4M17 17l1 4"/><circle cx="8.5" cy="14" r="1"/><circle cx="15.5" cy="14" r="1"/>`,
];
const stops = ['INSCRIPCIÓN', 'BUILD', 'ABORDAJE'];
---

<section class="steps" id="como" aria-labelledby="steps-title">
  <div class="inner">
    <header class="head">
      <h2 id="steps-title">{steps.h2}</h2>
      <p class="sub">Una semana online para ganarte el asiento. Tres paradas, un solo destino: la Hackatón Tren Solar.</p>
    </header>

    <ol class="line">
      {steps.items.map((s, i) => (
        <li class:list={['stop', i === 2 && 'stop--last']}>
          <span class="node" aria-hidden="true"></span>
          <article class="card">
            <header class="card-head mono">
              <span class="n">{s.n}</span>
              <span class="tag">PARADA · {stops[i]}</span>
            </header>
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i]} />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <i class="chamfer" aria-hidden="true"></i>
          </article>
        </li>
      ))}
    </ol>

    <p class="note mono">
      <span class="note-dot" aria-hidden="true"></span>
      {steps.note}
    </p>
  </div>
</section>

<style>
  .steps {
    position: relative;
    background:
      radial-gradient(ellipse 60% 50% at 100% 0%, rgba(255, 90, 31, 0.12), transparent 70%),
      var(--navy-950);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: var(--sp-16) 0;
    overflow: hidden;
  }
  .inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .mono {
    font-family: var(--font-mono);
  }
  .head {
    display: grid;
    gap: var(--sp-4);
    max-width: 62ch;
    margin-bottom: var(--sp-12);
  }
  .eyebrow {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--orange-400);
  }
  h2 {
    font: 900 var(--fs-h1) / var(--lh-h1) var(--font-display);
    letter-spacing: -0.03em;
    margin: 0;
  }
  .sub {
    margin: 0;
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--text-muted);
  }

  /* Vía: línea punteada naranja con nodos de estación */
  .line {
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--sp-8);
    display: grid;
    gap: var(--sp-8);
    position: relative;
  }
  .line::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    border-left: 2px dotted var(--orange-500);
    opacity: 0.9;
  }
  .stop {
    position: relative;
  }
  .node {
    position: absolute;
    left: calc(-1 * var(--sp-8));
    top: 28px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--navy-950);
    border: 3px solid var(--orange-500);
    box-shadow: 0 0 0 4px var(--navy-950);
  }
  .stop--last .node {
    background: var(--orange-500);
  }

  .card {
    position: relative;
    background: linear-gradient(180deg, rgba(27, 58, 107, 0.55), rgba(18, 43, 85, 0.7));
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--r-md);
    padding: var(--sp-6);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    display: grid;
    gap: var(--sp-3);
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, transparent 0 15px, rgba(255, 255, 255, 0.025) 15px 16px);
    pointer-events: none;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.28);
    box-shadow: 0 20px 40px rgba(6, 15, 34, 0.6);
  }
  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-3);
  }
  .n {
    font: 700 var(--fs-h2) / 1 var(--font-mono);
    color: var(--orange-500);
    letter-spacing: -0.02em;
  }
  .tag {
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--orange-300);
    padding: 4px 8px;
    border: 1px solid rgba(255, 122, 42, 0.45);
    background: rgba(6, 15, 34, 0.5);
    border-radius: var(--r-pill);
  }
  .icon {
    width: 36px;
    height: 36px;
    color: var(--orange-300);
    margin-top: var(--sp-2);
  }
  h3 {
    font: 700 var(--fs-h3) / var(--lh-h3) var(--font-display);
    letter-spacing: -0.01em;
    margin: 0;
  }
  .card p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .chamfer {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 28px;
    height: 28px;
    background: var(--orange-500);
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .stop--last .chamfer,
  .card:hover .chamfer {
    opacity: 1;
  }
  .note {
    margin: var(--sp-10, 40px) 0 0;
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--ink-400);
    max-width: 76ch;
  }
  .note-dot {
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 6px;
    background: var(--orange-500);
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
  }

  @media (min-width: 900px) {
    .steps {
      padding: var(--sp-24) 0;
    }
    .head {
      grid-template-columns: 1fr;
      margin-bottom: var(--sp-16);
    }
    .line {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-6);
      padding: var(--sp-8) 0 0;
    }
    .line::before {
      inset: 7px 0 auto 0;
      border-left: 0;
      border-top: 2px dotted var(--orange-500);
    }
    .node {
      left: var(--sp-6);
      top: calc(-1 * var(--sp-8));
    }
    .card {
      height: 100%;
      padding: var(--sp-8) var(--sp-6) var(--sp-8);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .chamfer {
      transition: none;
    }
    .card:hover {
      transform: none;
    }
  }
</style>
