---
/**
 * Tren Solar 2D: exactamente dos coches (blanco, faldón naranja, frente navy).
 * Cruza el viewport en loop. Con prefers-reduced-motion queda quieto.
 */
interface Props {
  /** Sufijo para ids del SVG (hay más de un tren en la página). */
  id: string;
}
const { id } = Astro.props;
---

<section class="run" id={`tren-${id}`} data-train aria-label="Tren Solar a toda velocidad">
  <p class="sr">Tren Solar de dos vagones: carrocería blanca, faldón naranja y frente navy.</p>
  <div class="lane" aria-hidden="true">
    <svg class="train" viewBox="0 0 960 200" xmlns="http://www.w3.org/2000/svg">
      <g class="streaks">
        <rect x="0" y="74" width="34" height="3" fill="#ff7a2a" />
        <rect x="10" y="92" width="22" height="2" fill="#d6deec" />
        <rect x="0" y="110" width="42" height="3" fill="#ff5a1f" />
        <rect x="16" y="128" width="18" height="2" fill="#ffd0b0" />
      </g>

      <!-- Coche 2 (cola): blanco + faldón naranja. Sin segundo frente de marca. -->
      <path fill="#f6f3ec" d="M78 56 H400 Q422 56 422 78 V130 H48 Q30 130 30 112 V78 Q30 56 78 56 Z" />
      <path fill="#c5cad2" d="M86 42 H372 Q384 42 384 50 V56 H74 V50 Q74 42 86 42 Z" />
      <rect x="150" y="34" width="86" height="10" rx="2" fill="#ff5a1f" />
      <rect x="152" y="36" width="82" height="2" fill="rgba(255,255,255,.55)" />
      <rect x="64" y="70" width="52" height="32" rx="2" fill="#0b1d3a" />
      <rect x="124" y="70" width="52" height="32" rx="2" fill="#0b1d3a" />
      <rect x="184" y="70" width="52" height="32" rx="2" fill="#0b1d3a" />
      <rect x="244" y="70" width="52" height="32" rx="2" fill="#0b1d3a" />
      <rect x="304" y="70" width="52" height="32" rx="2" fill="#0b1d3a" />
      <rect x="66" y="72" width="48" height="6" fill="rgba(214,222,236,.35)" />
      <rect x="126" y="72" width="48" height="6" fill="rgba(214,222,236,.35)" />
      <rect x="186" y="72" width="48" height="6" fill="rgba(214,222,236,.35)" />
      <rect x="246" y="72" width="48" height="6" fill="rgba(214,222,236,.35)" />
      <rect x="306" y="72" width="48" height="6" fill="rgba(214,222,236,.35)" />
      <path fill="#e7e2d8" stroke="#0b1d3a" stroke-width="1.4" d="M366 68 H398 V128 H366 Z" />
      <path stroke="#0b1d3a" stroke-width="1.2" d="M382 68 V128" />
      <path fill="#ff5a1f" d="M40 122 H414 L404 158 H58 Z" />
      <circle cx="40" cy="100" r="5" fill="#ff5a1f" />
      <rect x="108" y="152" width="230" height="5" rx="2" fill="#1c1f26" />
      <g>
        <circle cx="140" cy="166" r="16" fill="#141820" />
        <circle cx="140" cy="166" r="7" fill="#d6deec" />
        <circle cx="300" cy="166" r="16" fill="#141820" />
        <circle cx="300" cy="166" r="7" fill="#d6deec" />
      </g>

      <!-- Fuelle entre los dos coches -->
      <rect x="414" y="92" width="64" height="26" rx="3" fill="#1a1e28" />
      <path stroke="#3a4150" stroke-width="2" d="M426 96 V114 M446 96 V114 M466 96 V114" />

      <!-- Coche 1 (punta): blanco, faldón que sube, frente navy -->
      <path fill="#f6f3ec" d="M530 56 H748 V130 H508 Q490 130 490 112 V78 Q490 56 530 56 Z" />
      <path fill="#c5cad2" d="M538 42 H730 Q742 42 742 50 V56 H526 V50 Q526 42 538 42 Z" />
      <rect x="590" y="34" width="86" height="10" rx="2" fill="#ff5a1f" />
      <rect x="592" y="36" width="82" height="2" fill="rgba(255,255,255,.55)" />
      <rect x="524" y="70" width="52" height="32" rx="2" fill="#0b1d3a" />
      <rect x="584" y="70" width="52" height="32" rx="2" fill="#0b1d3a" />
      <rect x="644" y="70" width="52" height="32" rx="2" fill="#0b1d3a" />
      <rect x="526" y="72" width="48" height="6" fill="rgba(214,222,236,.35)" />
      <rect x="586" y="72" width="48" height="6" fill="rgba(214,222,236,.35)" />
      <rect x="646" y="72" width="48" height="6" fill="rgba(214,222,236,.35)" />
      <path fill="#e7e2d8" stroke="#0b1d3a" stroke-width="1.4" d="M708 68 H742 V128 H708 Z" />
      <path stroke="#0b1d3a" stroke-width="1.2" d="M725 68 V128" />
      <path fill="#ff5a1f" d="M500 122 H760 L828 104 L804 158 H518 Z" />

      <!-- Frente navy: parabrisas a paragolpes -->
      <path fill="#0b1d3a" d="M736 52 C820 50 888 70 906 102 C888 140 820 156 748 156 L736 138 V70 Z" />
      <path fill="#16325c" d="M768 70 C824 72 862 84 874 102 C860 118 824 128 768 130 Z" />
      <path fill="none" stroke="rgba(255,255,255,.55)" stroke-width="2" stroke-linecap="round" d="M784 80 C822 84 850 94 860 102" />
      <circle cx="896" cy="92" r="5.5" fill="#fff3d0" />
      <circle cx="896" cy="114" r="5.5" fill="#fff3d0" />
      <path fill="#ff5a1f" d="M888 128 H906 L900 140 H882 Z" />

      <rect x="548" y="152" width="200" height="5" rx="2" fill="#1c1f26" />
      <g>
        <circle cx="580" cy="166" r="16" fill="#141820" />
        <circle cx="580" cy="166" r="7" fill="#d6deec" />
        <circle cx="720" cy="166" r="16" fill="#141820" />
        <circle cx="720" cy="166" r="7" fill="#d6deec" />
      </g>
    </svg>
  </div>
  <div class="bed" aria-hidden="true">
    <i class="rail"></i>
  </div>
</section>

<style>
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .run {
    position: relative;
    overflow: hidden;
    height: 168px;
    background:
      linear-gradient(180deg, rgba(255, 90, 31, 0.08), transparent 42%),
      var(--cosmos-950);
    border-top: 1px solid var(--edge);
    border-bottom: 1px solid var(--edge);
  }
  .lane {
    position: absolute;
    top: 0;
    left: 0;
    width: min(920px, 92vw);
    height: 148px;
    animation: race 3.1s linear infinite;
    will-change: transform;
  }
  .train {
    display: block;
    width: 100%;
    height: 100%;
  }
  .bed {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18px;
    height: 14px;
    pointer-events: none;
  }
  .rail {
    position: absolute;
    left: 0;
    right: 0;
    top: 6px;
    height: 3px;
    background: repeating-linear-gradient(
      90deg,
      rgba(255, 122, 42, 0.95) 0 22px,
      transparent 22px 34px
    );
    box-shadow: 0 8px 0 rgba(11, 29, 58, 0.9);
  }
  @keyframes race {
    from { transform: translate3d(100vw, 0, 0); }
    to { transform: translate3d(-105%, 0, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .lane {
      animation: none;
      left: 50%;
      width: min(720px, 92vw);
      transform: translateX(-50%);
    }
    .streaks {
      display: none;
    }
  }
</style>
