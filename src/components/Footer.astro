---
import { copy } from '../content/copy';
import { links } from '../content/links';
import { resolveCta } from '../lib/cta';

const { footer, nav } = copy;
const { state, href: lumaHref } = resolveCta();
const all: { label: string; href: string | null }[] = [
  { label: footer.links.luma, href: state === 'open' ? lumaHref : null },
  { label: footer.links.repo, href: links.repo },
  { label: footer.links.social, href: links.social },
];
const items = all.filter((i) => i.href);
---

<footer class="footer">
  <div class="footer__shard" aria-hidden="true"></div>
  <div class="footer__inner">
    <img class="footer__logo" src="/brand/logo-jujuy-dev.svg" alt={nav.logoAlt} height="28" width="160" />
    {
      items.length > 0 && (
        <nav aria-label={footer.linksLabel}>
          <ul class="footer__links">
            {items.map((i) => (
              <li><a href={i.href!} rel="noopener">{i.label}</a></li>
            ))}
          </ul>
        </nav>
      )
    }
    <p class="footer__made">
      {footer.madeIn} · <a href={links.site}>{footer.site}</a>
    </p>
    <p class="footer__mono">{footer.mono}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    background: var(--navy-950);
    border-top: var(--border);
    padding: var(--sp-12) 0;
  }
  .footer__shard {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 220px;
    height: 220px;
    background: var(--orange-500);
    clip-path: polygon(0 40%, 0 100%, 60% 100%);
    opacity: 0.9;
  }
  .footer__inner {
    position: relative;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter) 0 calc(var(--gutter) + 40px);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  .footer__logo {
    height: 28px;
    width: auto;
    align-self: flex-start;
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer a {
    color: var(--orange-500);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer a:hover {
    text-decoration-thickness: 2px;
  }
  .footer__made {
    margin: 0;
    color: var(--text);
  }
  .footer__made a {
    font-family: var(--font-text);
    text-transform: none;
    letter-spacing: 0;
  }
  .footer__mono {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.08em;
    color: var(--ink-400);
  }
  @media (min-width: 768px) {
    .footer__inner {
      padding-right: 32px;
    }
    .footer__shard {
      width: 320px;
      height: 320px;
    }
    .footer__inner {
      padding-left: calc(32px + 120px);
    }
  }
  @media (min-width: 1024px) {
    .footer__inner {
      padding-right: 48px;
      padding-left: calc(48px + 120px);
    }
  }
</style>
