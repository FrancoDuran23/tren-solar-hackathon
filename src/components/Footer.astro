---
import { copy } from '../content/copy';
import { dates } from '../content/dates';
import { links } from '../content/links';
import { resolveCta } from '../lib/cta';

const { footer, nav, board } = copy;
const { state, href: lumaHref } = resolveCta();
const all: { label: string; href: string | null }[] = [
  { label: footer.links.luma, href: state === 'open' ? lumaHref : null },
  { label: footer.links.repo, href: links.repo },
  { label: footer.links.social, href: links.social },
];
const items = all.filter((i) => i.href);
const anchors = nav.links;
const year = new Date().getFullYear();
---

<footer class="footer">
  <!-- Franja plateada: el metal del ticket, estática. Una sola marquee en la página (la de arriba). -->
  <div class="strip" aria-hidden="true">
    <div class="strip__inner mono">
      <span>{nav.lockup}</span>
      <span class="strip__route"><b>JUJ</b><i></i><b>HTS</b></span>
      <span class="strip__right">IDEAS QUE VIAJAN MÁS LEJOS</span>
    </div>
  </div>

  <div class="footer__inner">
    <div class="footer__brand">
      <img src="/brand/jujuydev-logo-white.webp" alt={nav.logoAlt} width="443" height="120" loading="lazy" decoding="async" />
      <p class="footer__made">{footer.madeIn}</p>
      <a class="footer__site" href={links.site} rel="noopener">
        {footer.site}
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l6-6M4 3h5v5" /></svg>
      </a>
    </div>

    <nav class="footer__nav" aria-label={nav.lockup}>
      <p class="footer__label mono">RECORRIDO</p>
      <ul>
        {anchors.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer__board">
      <p class="footer__label mono">{board.label.toUpperCase()}</p>
      <dl class="board mono">
        <div><dt>SALIDA</dt><dd>JUJUY · ONLINE</dd></div>
        <div><dt>DESTINO</dt><dd>HACKATÓN TREN SOLAR</dd></div>
        <div><dt>ANDÉN</dt><dd>JUJ</dd></div>
        <div><dt>BUILD</dt><dd>{dates.buildMono}</dd></div>
        <div><dt>GANADORES</dt><dd>{dates.winnersMono}</dd></div>
      </dl>
      {items.length > 0 && (
        <ul class="footer__links" aria-label={footer.linksLabel}>
          {items.map((i) => (
            <li>
              <a href={i.href!} rel="noopener">
                {i.label}
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l6-6M4 3h5v5" /></svg>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <div class="footer__bottom">
    <p class="mono">© {year} JUJUY.DEV · {footer.mono}</p>
  </div>
  <i class="footer__shard" aria-hidden="true"></i>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    background: var(--cosmos-950);
    color: var(--text);
    isolation: isolate;
  }
  .mono {
    font-family: var(--font-mono);
  }

  /* Franja plateada (metal cepillado del ticket) */
  .strip {
    /* Misma lámina holográfica que la franja del ticket */
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.45), rgba(255, 255, 255, 0) 40%, rgba(11, 14, 22, 0.08) 100%),
      linear-gradient(100deg, #f3c9da 0%, #fff0c8 9%, #d6f6e0 18%, #c4e6ff 27%, #d9ccff 36%, #ffcde8 45%, #f6f7f9 52%, #ffe5c2 60%, #cdf2e4 68%, #c7dcff 77%, #e1cdff 86%, #f3c9da 100%);
    color: var(--navy-950);
    border-top: 1px solid rgba(255, 255, 255, 0.5);
    border-bottom: 1px solid rgba(6, 15, 34, 0.35);
  }
  .strip__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 14px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .strip__route {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .strip__route i {
    width: 72px;
    height: 0;
    border-top: 2px dotted var(--orange-600);
    position: relative;
  }
  .strip__route i::after {
    content: '';
    position: absolute;
    right: -1px;
    top: -5px;
    width: 8px;
    height: 8px;
    border-top: 2px solid var(--orange-600);
    border-right: 2px solid var(--orange-600);
    transform: rotate(45deg);
  }
  .strip__right {
    display: none;
  }

  .footer__inner {
    position: relative;
    z-index: 1;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--sp-16) var(--gutter) var(--sp-12);
    display: grid;
    gap: var(--sp-12);
  }
  .footer__brand img {
    height: 30px;
    width: auto;
    display: block;
  }
  .footer__made {
    margin: var(--sp-4) 0 var(--sp-1);
    color: var(--text);
  }
  .footer__site {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--orange-400);
    text-decoration: none;
    font-weight: 600;
  }
  .footer__site:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer__label {
    margin: 0 0 var(--sp-3);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--ink-400);
  }
  .footer__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
  }
  .footer__nav a {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
  }
  .footer__nav a:hover {
    color: var(--orange-300);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  /* Tablero como talón de papel: el único bloque claro del pie */
  .board {
    margin: 0;
    display: grid;
    gap: 8px;
    font-size: 11px;
    letter-spacing: 0.08em;
    background: linear-gradient(180deg, #11151f, #0b0e16);
    color: var(--white);
    border: 1px solid var(--edge);
    padding: var(--sp-4) var(--sp-4);
    clip-path: polygon(12px 0, calc(100% - 12px) 0, 100% 12px, 100% calc(100% - 12px), calc(100% - 12px) 100%, 12px 100%, 0 calc(100% - 12px), 0 12px);
  }
  .board div {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: var(--sp-3);
  }
  .board dt {
    color: rgba(255, 255, 255, 0.55);
  }
  .board dd {
    margin: 0;
    font-weight: 700;
  }
  .footer__links {
    list-style: none;
    margin: var(--sp-4) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
  }
  .footer__links a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--orange-400);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer__bottom {
    position: relative;
    z-index: 1;
    background: var(--cosmos-950);
    border-top: 1px solid var(--edge);
    padding: var(--sp-4) var(--gutter) var(--sp-6);
  }
  .footer__bottom p {
    margin: 0 auto;
    max-width: var(--container-max);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-400);
  }
  /* Shard naranja del poster, esquina inferior izquierda */
  .footer__shard {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 220px;
    height: 160px;
    background: var(--orange-500);
    clip-path: polygon(0 45%, 0 100%, 55% 100%);
    z-index: 0;
  }

  @media (min-width: 768px) {
    .strip__right {
      display: inline;
    }
    .footer__inner {
      grid-template-columns: 1.2fr 1fr 1.4fr;
      padding-top: var(--sp-24);
    }
    .footer__shard {
      width: 360px;
      height: 260px;
    }
  }
</style>
