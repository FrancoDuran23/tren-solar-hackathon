---
import { copy } from '../content/copy';
const { criteria: c } = copy;
---

<section class="criteria" id={c.id} aria-labelledby="crit-title">
  <div class="inner">
    <h2 id="crit-title">{c.h2}</h2>

    <div class="gate">
      <span class="gate__label">⛌ {c.gateLabel}</span>
      <p class="gate__text"><strong>{c.gate}</strong> {c.gateNote}</p>
    </div>

    <ul class="grid">
      {c.items.map((it) => (
        <li class="card">
          <h3>{it.title}</h3>
          <p>{it.text}</p>
          <div class="scale" aria-label={`Puntaje ${c.scale}`}>
            <span>0</span><span class="bar" aria-hidden="true"></span><span>10</span>
          </div>
        </li>
      ))}
      <li class="card card--tall">
        <h3>{c.traction.title}</h3>
        <p>{c.traction.text}</p>
        <ul class="chips">
          {c.traction.chips.map((ch) => <li>{ch}</li>)}
        </ul>
        <p class="tnote">{c.traction.note}</p>
        <div class="scale" aria-label={`Puntaje ${c.scale}`}>
          <span>0</span><span class="bar" aria-hidden="true"></span><span>10</span>
        </div>
      </li>
    </ul>
    <p class="scalenote">{c.scaleNote}</p>

    <div class="split">
      <div class="half">
        <span class="pct">{c.split.a.pct}</span>
        <span class="lbl">{c.split.a.label}</span>
      </div>
      <div class="half">
        <span class="pct">{c.split.b.pct}</span>
        <span class="lbl">{c.split.b.label}</span>
      </div>
    </div>
    <p class="splittext">{c.split.text}</p>
  </div>
</section>

<style>
  .criteria {
    background: var(--navy-900);
    border-top: var(--border);
    padding: var(--sp-12) 0;
  }
  .inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  h2 {
    font: 700 var(--fs-h1) / var(--lh-h1) var(--font-display);
    letter-spacing: -0.02em;
    margin: 0 0 var(--sp-8);
  }
  .gate {
    background: var(--navy-800);
    border-left: 4px solid var(--orange-500);
    border-radius: var(--r-md);
    padding: var(--sp-6);
    margin-bottom: var(--sp-8);
  }
  .gate__label {
    font: 700 var(--fs-small) var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--orange-400);
  }
  .gate__text {
    margin: var(--sp-3) 0 0;
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: 1fr;
  }
  .card {
    background: var(--navy-800);
    border: var(--border);
    border-radius: var(--r-md);
    padding: var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    transition: background var(--dur-base) var(--ease-out);
  }
  .card:hover {
    background: var(--navy-700);
  }
  h3 {
    font: 700 var(--fs-h3) / var(--lh-h3) var(--font-display);
    margin: 0;
  }
  .card p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .scale {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font: var(--fs-micro) var(--font-mono);
    color: var(--ink-400);
    padding-top: var(--sp-3);
  }
  .bar {
    flex: 1;
    height: 4px;
    background: repeating-linear-gradient(90deg, var(--orange-500) 0 2px, transparent 2px 10%);
  }
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .chips li {
    font: var(--fs-micro) var(--font-mono);
    letter-spacing: 0.08em;
    border: 1px solid var(--orange-500);
    color: var(--orange-400);
    border-radius: var(--r-xs);
    padding: 4px 8px;
  }
  .scalenote {
    font: var(--fs-small) var(--font-mono);
    color: var(--ink-400);
    margin: var(--sp-4) 0 var(--sp-12);
  }
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: var(--border-strong);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .half {
    padding: var(--sp-6);
    display: grid;
    gap: var(--sp-1);
    background: var(--navy-800);
    text-align: center;
  }
  .half + .half {
    border-left: 2px dashed var(--orange-500);
  }
  .pct {
    font: 900 var(--fs-h1) / 1 var(--font-display);
    color: var(--orange-500);
  }
  .lbl {
    font: var(--fs-small) var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .splittext {
    margin: var(--sp-4) 0 0;
    color: var(--text-muted);
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .criteria {
      padding: var(--sp-24) 0;
    }
    .grid {
      grid-template-columns: repeat(5, 1fr);
    }
    .card--tall {
      grid-row: span 1;
      padding-bottom: var(--sp-12);
    }
  }
</style>
