---
import { copy } from '../content/copy';
const { criteria: c } = copy;
---

<section class="criteria" id={c.id} aria-labelledby="crit-title">
  <div class="inner">
    <h2 id="crit-title">{c.h2}</h2>

    <!-- Control de acceso: una línea con el molinete, sin card ni borde lateral -->
    <p class="gate">
      <svg class="gate__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 21V9M4 9h9M4 13h9M4 17h9" /><circle cx="17" cy="7" r="3" /><path d="M17 10v11" />
      </svg>
      <span><strong>{c.gate}</strong> {c.gateNote}</span>
    </p>

    <!-- Los cuatro criterios como planilla: filas con regla fina, puntaje 0–10 a la derecha -->
    <ol class="ledger" aria-label="Criterios de 0 a 10">
      {c.items.map((it) => (
        <li class="row">
          <h3>{it.title}</h3>
          <p>{it.text}</p>
          <span class="scale mono" aria-label={`Puntaje ${c.scale}`}>
            <span>0</span><i aria-hidden="true"></i><span>10</span>
          </span>
        </li>
      ))}
    </ol>
    <p class="scalenote">{c.scaleNote}</p>

    <!-- Tracción: no es la quinta fila; es el bloque que pesa más -->
    <article class="traction tk-panel tk-corner" aria-labelledby="trac-title">
      <div class="traction__head">
        <p class="tag mono"><i aria-hidden="true"></i>{c.traction.tag}</p>
        <h3 id="trac-title">{c.traction.title}</h3>
      </div>
      <div class="traction__body">
        <p class="ttext">{c.traction.text}</p>
        <ul class="chips mono" aria-label="Tipos de evidencia">
          {c.traction.chips.map((ch) => <li>{ch}</li>)}
        </ul>
        <p class="tnote">{c.traction.note}</p>
      </div>
    </article>

    <p class="verdict">{c.verdict}</p>
  </div>
</section>

<style>
  /* Sección en papel: el scoring se lee como una planilla, no como otra pared navy */
  .criteria {
    background: var(--cosmos-900);
    color: var(--white);
    padding: var(--sp-12) 0;
  }
  .inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .mono {
    font-family: var(--font-mono);
  }
  h2 {
    font: 700 var(--fs-h1) / var(--lh-h1) var(--font-display);
    letter-spacing: -0.02em;
    margin: 0 0 var(--sp-8);
    text-wrap: balance;
  }
  .gate {
    display: flex;
    gap: var(--sp-4);
    align-items: flex-start;
    margin: 0 0 var(--sp-10, 40px);
    padding: var(--sp-5, 20px) 0;
    border-top: 1px solid var(--edge-strong);
    border-bottom: 1px solid var(--edge);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--text-muted);
  }
  .gate strong {
    color: var(--white);
  }
  .gate__icon {
    flex: none;
    width: 28px;
    height: 28px;
    margin-top: 2px;
    color: var(--orange-400);
  }

  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-2) var(--sp-8);
    padding: var(--sp-5, 20px) 0;
    border-top: 1px solid var(--edge);
  }
  .row:last-child {
    border-bottom: 1px solid var(--edge);
  }
  h3 {
    font: 700 var(--fs-h3) / var(--lh-h3) var(--font-display);
    letter-spacing: -0.01em;
    margin: 0;
  }
  .row p {
    margin: 0;
    color: var(--text-muted);
    max-width: 52ch;
  }
  .scale {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink-200);
    font-variant-numeric: tabular-nums;
  }
  .scale i {
    width: 120px;
    height: 0;
    border-top: 2px dotted var(--orange-500);
  }
  .scalenote {
    margin: var(--sp-3) 0 var(--sp-10, 40px);
    font: var(--fs-small) / var(--lh-small) var(--font-text);
    color: var(--ink-400);
  }

  /* Bloque de tracción: navy sobre papel, esquina chanfleada, naranja como estructura */
  .traction {
    color: var(--white);
    padding: var(--sp-8) var(--sp-6);
    display: grid;
    gap: var(--sp-6);
    box-shadow: 0 28px 56px rgba(0, 0, 0, 0.4);
  }
  /* Hairline holo arriba del bloque: la lámina del ticket marca lo que pesa más */
  .traction::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
    background: var(--holo);
  }
  .tag {
    margin: 0 0 var(--sp-3);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--orange-400);
  }
  .tag i {
    width: 10px;
    height: 10px;
    background: var(--orange-500);
  }
  .traction h3 {
    font: 900 clamp(40px, 4.4vw, 60px) / 0.95 var(--font-display);
    overflow-wrap: anywhere;
    letter-spacing: -0.03em;
  }
  .ttext {
    margin: 0;
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: rgba(255, 255, 255, 0.86);
    max-width: 48ch;
  }
  .chips {
    list-style: none;
    margin: var(--sp-5, 20px) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .chips li {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    background: var(--orange-500);
    color: var(--navy-950);
    padding: 6px 10px;
  }
  .tnote {
    margin: var(--sp-3) 0 0;
    font-size: var(--fs-small);
    color: rgba(255, 255, 255, 0.72);
  }
  .verdict {
    margin: var(--sp-10, 40px) 0 0;
    padding-top: var(--sp-5, 20px);
    border-top: 1px solid var(--edge-strong);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--text-muted);
    max-width: 60ch;
  }
  .verdict::first-line {
    color: var(--white);
  }

  @media (min-width: 760px) {
    .row {
      grid-template-columns: minmax(200px, 0.9fr) 2fr auto;
      align-items: baseline;
    }
    .traction {
      grid-template-columns: minmax(320px, 1fr) 1.5fr;
      gap: var(--sp-10, 40px);
      padding: var(--sp-10, 40px) var(--sp-8);
      align-items: start;
    }
  }
  @media (min-width: 1100px) {
    .criteria {
      padding: var(--sp-24) 0;
    }
    .traction {
      padding: var(--sp-12) var(--sp-12);
    }
  }
</style>
