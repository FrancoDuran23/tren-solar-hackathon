---
import { copy } from '../content/copy';
import Cta from './Cta.astro';

const { nav, a11y, auth } = copy;
---

<header class="nav" data-nav>
  <div class="nav__bar">
    <a class="nav__brand" href="#top" aria-label={nav.logoAlt}>
      <img src="/brand/jujuydev-logo-white.webp" alt="" width="443" height="120" decoding="async" />
    </a>

    <nav class="nav__links" id="nav-links" aria-label={a11y.mainNav}>
      {nav.links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>

    <div class="nav__session" id="nav-session">
      <button type="button" class="nav-auth" data-signin aria-label={auth.signIn}>
        <span class="nav-auth__long">{auth.signIn}</span>
        <span class="nav-auth__short" aria-hidden="true">{auth.signInShort}</span>
      </button>
      <div class="nav-user" data-signed-in hidden>
        <a class="nav-user__link" href="#perfil">
          <span class="nav-user__avatar">
            <img data-avatar alt="" width="32" height="32" hidden referrerpolicy="no-referrer" />
            <span data-initials aria-hidden="true"></span>
          </span>
          <span class="nav-user__name" data-name></span>
        </a>
        <a class="nav-user__estado" href="#mi-estado">{auth.estado}</a>
        <button type="button" class="nav-out" data-signout>{auth.signOut}</button>
      </div>
      <p class="nav-note" data-auth-note hidden role="status"></p>
    </div>

    <div class="nav__cta"><Cta size="sm" /></div>

    <button
      class="nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-links"
      aria-label={a11y.menuOpen}
      data-open-label={a11y.menuOpen}
      data-close-label={a11y.menuClose}
    >
      <span></span><span></span><span></span>
    </button>
  </div>
  <div
    class="nav__track"
    role="progressbar"
    aria-label={a11y.progress}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <div class="nav__rail"></div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(5, 7, 13, 0.74);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--edge);
    transition: background var(--dur-base) var(--ease-out);
  }
  .nav[data-scrolled] {
    background: rgba(5, 7, 13, 0.9);
  }
  .nav__bar {
    max-width: var(--container-max);
    margin: 0 auto;
    height: 64px;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--sp-6);
  }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    color: var(--text);
    text-decoration: none;
    margin-right: auto;
  }
  .nav__brand img {
    height: 26px;
    width: auto;
    display: block;
  }
  .nav__links {
    display: none;
    gap: var(--sp-6);
  }
  .nav__links a {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    color: var(--text);
    text-decoration: none;
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
    padding: 6px 0;
    position: relative;
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--orange-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .nav__links a:hover::after,
  .nav__links a:focus-visible::after {
    transform: scaleX(1);
  }
  .nav__session {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    position: relative;
    flex-shrink: 0;
  }
  .nav-auth,
  .nav-out,
  .nav-user__estado,
  .nav-user__link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-sm);
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-auth {
    padding: 0 14px;
    border: 0;
    border-radius: 0;
    clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 0 100%);
    background: var(--orange-500);
    color: var(--cosmos-950);
    cursor: pointer;
  }
  .nav-auth:hover:not(:disabled) { background: var(--orange-400); }
  .nav-auth:disabled { opacity: 0.55; cursor: not-allowed; }
  .nav-auth__short { display: none; }
  .nav-user { display: flex; align-items: center; gap: var(--sp-2); }
  .nav-user__link { color: var(--text); gap: var(--sp-2); padding: 0 4px; }
  .nav-user__avatar {
    width: 32px;
    height: 32px;
    border-radius: var(--r-pill);
    overflow: hidden;
    background: var(--cosmos-700);
    color: var(--orange-300);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
  }
  .nav-user__avatar img { width: 32px; height: 32px; object-fit: cover; display: block; }
  .nav-user__name {
    max-width: 10ch;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .nav-user__estado { color: var(--text); padding: 0 8px; }
  .nav-out {
    padding: 0 12px;
    background: transparent;
    color: var(--text);
    border: 1px solid var(--edge-strong);
    border-radius: 0;
    cursor: pointer;
  }
  .nav-note {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: max-content;
    max-width: 260px;
    margin: 0;
    padding: var(--sp-2) var(--sp-3);
    background: var(--cosmos-900);
    border: 1px solid var(--orange-500);
    color: var(--orange-300);
    font-size: var(--fs-small);
    z-index: 2;
  }
  .nav__session [hidden] { display: none !important; }
  .nav__cta {
    display: none;
  }
  .nav__toggle {
    flex-shrink: 0;
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0 11px;
    background: transparent;
    border: var(--border);
    border-radius: var(--r-sm);
    cursor: pointer;
  }
  .nav__toggle span {
    height: 2px;
    background: var(--white);
    transition: transform var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out);
  }
  .nav[data-open] .nav__toggle span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav[data-open] .nav__toggle span:nth-child(2) {
    opacity: 0;
  }
  .nav[data-open] .nav__toggle span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile: panel desplegable */
  .nav[data-open] .nav__links {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: absolute;
    top: 64px;
    left: 0;
    right: 0;
    background: rgba(5, 7, 13, 0.97);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: var(--sp-2) var(--gutter) var(--sp-4);
  }
  .nav[data-open] .nav__links a {
    padding: var(--sp-3) 0;
    font-size: var(--fs-body);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .nav[data-open] .nav__links a::after {
    display: none;
  }

  .nav__track {
    height: 2px;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .nav[data-scrolled] .nav__track {
    opacity: 1;
  }
  .nav__rail {
    height: 100%;
    width: 100%;
    background: var(--orange-500);
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
  }

  @media (min-width: 480px) {
    .nav__cta {
      display: block;
    }
  }
  @media (max-width: 1099px) {
    .nav-auth__long { display: none; }
    .nav-auth__short { display: inline; }
    .nav-user__name,
    .nav-user__estado { display: none; }
  }
  @media (min-width: 1024px) {
    .nav__links {
      display: flex;
      margin-left: auto;
      gap: var(--sp-4);
    }
    .nav__brand {
      margin-right: 0;
    }
    .nav__toggle {
      display: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = nav?.querySelector<HTMLButtonElement>('.nav__toggle');
  const track = nav?.querySelector<HTMLElement>('.nav__track');

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute(
        'aria-label',
        (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? '',
      );
    };
    toggle.addEventListener('click', () => setOpen(!nav.hasAttribute('data-open')));
    nav.querySelectorAll('.nav__links a').forEach((a) =>
      a.addEventListener('click', () => setOpen(false)),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.hasAttribute('data-open')) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Vía de progreso: aparece tras 80px de scroll (design §3.1)
    let ticking = false;
    const update = () => {
      ticking = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      nav.style.setProperty('--progress', String(p));
      nav.toggleAttribute('data-scrolled', window.scrollY > 80);
      track?.setAttribute('aria-valuenow', String(Math.round(p * 100)));
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>

<script>
  import { copy } from '../content/copy';
  import { loadMe, onAuthChange, signInWithGoogle, signOut } from '../lib/auth-client';
  import type { MeResponse } from '../lib/me';

  const root = document.getElementById('nav-session');
  if (root) {
    const signInBtn = root.querySelector<HTMLButtonElement>('[data-signin]');
    const signed = root.querySelector<HTMLElement>('[data-signed-in]');
    const note = root.querySelector<HTMLElement>('[data-auth-note]');
    const avatar = root.querySelector<HTMLImageElement>('[data-avatar]');
    const initials = root.querySelector<HTMLElement>('[data-initials]');
    const nameEl = root.querySelector<HTMLElement>('[data-name]');
    const out = root.querySelector<HTMLButtonElement>('[data-signout]');

    const showNote = (text: string) => {
      if (!note) return;
      note.hidden = text === '';
      note.textContent = text;
    };

    const paint = (me: MeResponse) => {
      if (!signInBtn || !signed) return;
      if (me.error) {
        signInBtn.hidden = false;
        signed.hidden = true;
        showNote(me.error);
        return;
      }
      showNote('');
      if (!me.user) {
        signInBtn.hidden = false;
        signInBtn.disabled = false;
        signed.hidden = true;
        return;
      }
      signInBtn.hidden = true;
      signed.hidden = false;
      if (nameEl) nameEl.textContent = me.user.name;
      const letter = (me.user.name || me.user.email || '?').trim().charAt(0).toUpperCase();
      if (initials) initials.textContent = letter;
      if (avatar) {
        if (me.user.image) {
          avatar.src = me.user.image;
          avatar.hidden = false;
          if (initials) initials.hidden = true;
        } else {
          avatar.removeAttribute('src');
          avatar.hidden = true;
          if (initials) initials.hidden = false;
        }
      }
    };

    signInBtn?.addEventListener('click', () => {
      if (!signInBtn) return;
      signInBtn.disabled = true;
      void loadMe().then(async (me) => {
        if (!me.configured) {
          showNote(copy.auth.unavailable);
          signInBtn.disabled = false;
          return;
        }
        const err = await signInWithGoogle();
        if (err) {
          showNote(err);
          signInBtn.disabled = false;
        }
      });
    });

    out?.addEventListener('click', () => {
      void signOut();
    });

    avatar?.addEventListener('error', () => {
      avatar.hidden = true;
      if (initials) initials.hidden = false;
    });

    const refresh = () => {
      void loadMe().then(paint);
    };
    onAuthChange(refresh);
    refresh();
  }
</script>
