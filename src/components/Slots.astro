---
import { copy } from '../content/copy';
const { slots } = copy;
---

<section class="slots" aria-labelledby="slots-title">
  <div class="inner">
    <div class="tickets">
      {[slots.a, slots.b].map((t) => (
        <article class="stub">
          <p class="num"><span>{t.n}</span> · {t.label}</p>
          <p class="desc">{t.text}</p>
        </article>
      ))}
    </div>
    <h2 id="slots-title">{slots.h2}</h2>
    <p class="text">{slots.text}</p>
  </div>
</section>

<style>
  .slots {
    position: relative;
    overflow: hidden;
    background: var(--navy-950);
    border-top: var(--border);
    padding: var(--sp-12) 0;
  }
  .slots::after {
    content: '';
    position: absolute;
    right: -180px;
    top: 50%;
    width: 420px;
    height: 420px;
    transform: translateY(-50%);
    border-radius: 50%;
    background: var(--grad-sun);
    opacity: 0.35;
    pointer-events: none;
  }
  .inner {
    position: relative;
    z-index: 1;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .tickets {
    display: grid;
    gap: var(--sp-4);
    margin-bottom: var(--sp-12);
  }
  .stub {
    background: var(--paper);
    color: var(--ink-950);
    padding: var(--sp-6);
    clip-path: polygon(
      var(--chamfer) 0, calc(100% - var(--chamfer)) 0, 100% var(--chamfer),
      100% calc(100% - var(--chamfer)), calc(100% - var(--chamfer)) 100%,
      var(--chamfer) 100%, 0 calc(100% - var(--chamfer)), 0 var(--chamfer)
    );
    border-left: 6px solid var(--orange-500);
  }
  .num {
    margin: 0 0 var(--sp-2);
    font: 700 var(--fs-h3) / 1.1 var(--font-mono);
    letter-spacing: 0.04em;
  }
  .num span {
    font: 900 var(--fs-ticket-no) / 1 var(--font-display);
    margin-right: var(--sp-2);
  }
  .desc {
    margin: 0;
    color: var(--ink-800);
  }
  h2 {
    font: 700 var(--fs-h1) / var(--lh-h1) var(--font-display);
    letter-spacing: -0.02em;
    margin: 0 0 var(--sp-6);
    max-width: 20ch;
  }
  .text {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-lead);
    max-width: 52ch;
  }
  @media (min-width: 700px) {
    .tickets {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 900px) {
    .slots {
      padding: var(--sp-24) 0;
    }
  }
</style>
