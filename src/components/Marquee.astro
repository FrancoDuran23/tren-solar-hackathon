---
import { TICKETS_TOTAL } from '../config';

const items = [
  'PRÓXIMA SALIDA',
  'HACKATÓN TREN SOLAR',
  `${TICKETS_TOTAL} TICKETS`,
  'ONLINE',
  'ANDÉN JUJUY',
  'IDEAS QUE VIAJAN MÁS LEJOS',
  'SPONSOR SORPRESA A BORDO',
];
---

<section class="marquee" aria-label="Movida tren" data-marquee>
  <div class="track" aria-hidden="true">
    {[0, 1].map(() => (
      <ul class="row">
        {items.map((t) => (
          <li>{t}<i class="sep" aria-hidden="true"></i></li>
        ))}
      </ul>
    ))}
  </div>
  <p class="sr-only">{items.join(' · ')}</p>
  <button type="button" class="toggle" aria-pressed="false" aria-label="Pausar marquee">
    <svg class="ic-pause" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><rect x="1" y="1" width="3" height="8" fill="currentColor"/><rect x="6" y="1" width="3" height="8" fill="currentColor"/></svg>
    <svg class="ic-play" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 1l7 4-7 4z" fill="currentColor"/></svg>
  </button>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((m) => {
    const b = m.querySelector<HTMLButtonElement>('.toggle')!;
    b.addEventListener('click', () => {
      const paused = m.classList.toggle('paused');
      b.setAttribute('aria-pressed', String(paused));
      b.setAttribute('aria-label', paused ? 'Reanudar marquee' : 'Pausar marquee');
    });
  });
</script>

<style>
  /* Franja naranja del tren del poster: navy sobre naranja, mono bold */
  .marquee {
    position: relative;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0) 40%, rgba(5, 7, 13, 0.12) 100%),
      var(--holo);
    color: var(--cosmos-950);
    overflow: hidden;
    font: 700 13px/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    border-top: 1px solid rgba(255, 255, 255, 0.6);
    border-bottom: 1px solid rgba(5, 7, 13, 0.6);
  }
  .marquee::before,
  .marquee::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(5, 7, 13, 0.2);
    pointer-events: none;
  }
  .marquee::before {
    top: 6px;
  }
  .marquee::after {
    bottom: 6px;
  }
  .track {
    display: flex;
    width: max-content;
    padding: 18px 0;
    animation: run 40s linear infinite;
  }
  .row {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: none;
  }
  li {
    white-space: nowrap;
  }
  .sep {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin: 0 26px;
    background: var(--orange-600);
    opacity: 0.9;
    transform: translateY(-1px) rotate(45deg);
  }
  .ic-play { display: none; }
  .marquee.paused .ic-play { display: block; }
  .marquee.paused .ic-pause { display: none; }
  @keyframes run {
    to {
      transform: translateX(-50%);
    }
  }
  .marquee:hover .track,
  .marquee:focus-within .track,
  .marquee.paused .track {
    animation-play-state: paused;
  }
  .toggle {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    background: var(--cosmos-950);
    color: var(--white);
    border: 1px solid rgba(5, 7, 13, 0.6);
    border-radius: var(--r-xs);
    padding: 7px 8px;
    line-height: 0;
    cursor: pointer;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
</style>
