---
const items = [
  'PRÓXIMA SALIDA',
  'PRE-HACKATÓN',
  '35 TICKETS',
  'ONLINE',
  'ANDÉN JUJUY',
  'IDEAS QUE VIAJAN MÁS LEJOS',
  'SPONSOR SORPRESA A BORDO',
];
---

<section class="marquee" aria-label="Movida tren" data-marquee>
  <div class="track" aria-hidden="true">
    {[0, 1].map(() => (
      <ul class="row">
        {items.map((t) => (
          <li>{t}<span class="sep">◆</span></li>
        ))}
      </ul>
    ))}
  </div>
  <p class="sr-only">{items.join(' · ')}</p>
  <button type="button" class="toggle" aria-pressed="false" aria-label="Pausar marquee">
    <span aria-hidden="true">❚❚</span>
  </button>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((m) => {
    const b = m.querySelector<HTMLButtonElement>('.toggle')!;
    b.addEventListener('click', () => {
      const paused = m.classList.toggle('paused');
      b.setAttribute('aria-pressed', String(paused));
      b.setAttribute('aria-label', paused ? 'Reanudar marquee' : 'Pausar marquee');
      b.firstElementChild!.textContent = paused ? '▶' : '❚❚';
    });
  });
</script>

<style>
  /* Franja naranja del tren del poster: navy sobre naranja, mono bold */
  .marquee {
    position: relative;
    background: var(--orange-500);
    color: var(--navy-950);
    overflow: hidden;
    font: 700 13px/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 -1px 0 rgba(6, 15, 34, 0.4) inset;
  }
  .marquee::before,
  .marquee::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(6, 15, 34, 0.35);
    pointer-events: none;
  }
  .marquee::before {
    top: 6px;
  }
  .marquee::after {
    bottom: 6px;
  }
  .track {
    display: flex;
    width: max-content;
    padding: 18px 0;
    animation: run 40s linear infinite;
  }
  .row {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: none;
  }
  li {
    white-space: nowrap;
  }
  .sep {
    color: var(--navy-950);
    opacity: 0.55;
    margin: 0 26px;
    font-size: 9px;
    vertical-align: 2px;
  }
  @keyframes run {
    to {
      transform: translateX(-50%);
    }
  }
  .marquee:hover .track,
  .marquee:focus-within .track,
  .marquee.paused .track {
    animation-play-state: paused;
  }
  .toggle {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    background: var(--navy-950);
    color: var(--white);
    border: 1px solid rgba(6, 15, 34, 0.6);
    border-radius: var(--r-xs);
    padding: 6px 8px;
    font: 10px/1 var(--font-mono);
    cursor: pointer;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
</style>
