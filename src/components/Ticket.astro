---
import { config, TICKETS_TOTAL } from '../config';

interface Props {
  /** Capa fantasma del stack: mismo markup, aria-hidden, sin canvas WebGPU */
  ghost?: boolean;
}
const { ghost = false } = Astro.props;

const isOpen = config.registration === 'open' && !!config.lumaUrl;
const art = '/brand/solar-train-quebrada.jpg';
const deadline = config.deadline
  ? new Date(config.deadline.iso).toLocaleDateString('es-AR')
  : 'POR CONFIRMAR';

/* Barcode estilizado determinista (decorativo) */
const bars: { x: number; w: number }[] = [];
{
  let x = 0;
  let seed = 7;
  while (x < 118) {
    seed = (seed * 31 + 11) % 97;
    const w = 1 + (seed % 3);
    if (seed % 5 !== 0) bars.push({ x, w });
    x += w + 1 + (seed % 2);
  }
}

/* QR decorativo 21x21 determinista; finder patterns en 3 esquinas */
const N = 21;
const cells: [number, number][] = [];
{
  let s = 42;
  const finder = (r: number, c: number) => {
    const inF = (a: number, b: number) => a >= 0 && a < 7 && b >= 0 && b < 7;
    const fr = r < 7 ? r : r - (N - 7);
    const fc = c < 7 ? c : c - (N - 7);
    if (!((r < 7 && c < 7) || (r < 7 && c >= N - 7) || (r >= N - 7 && c < 7))) return null;
    if (!inF(fr, fc)) return null;
    const ring = Math.max(Math.abs(fr - 3), Math.abs(fc - 3));
    return ring !== 2;
  };
  for (let r = 0; r < N; r++)
    for (let c = 0; c < N; c++) {
      const f = finder(r, c);
      s = (s * 1103515245 + 12345) & 0x7fffffff;
      const on = f === null ? (s >> 8) % 2 === 0 : f;
      if (on) cells.push([c, r]);
    }
}
---

<div class:list={['ticket', { ghost }]} aria-hidden={ghost ? 'true' : undefined} data-ticket>
  <div class="body" data-body>
    <!-- Fallback sin WebGPU: foto del poster en duotono navy→naranja -->
    <div class="art" aria-hidden="true">
      <img src={art} alt="" width="1024" height="775" loading={ghost ? 'lazy' : 'eager'} decoding="async" />
      <i class="tint hi"></i>
      <i class="tint lo"></i>
    </div>
    <div class="foil" aria-hidden="true"></div>
    {!ghost && <canvas class="foil-gl" data-foil-gl aria-hidden="true"></canvas>}
    <div class="grain" aria-hidden="true"></div>
    <div class="frame" aria-hidden="true"></div>

    <p class="word" aria-hidden="true"><span>PRE-</span><span>HACKATÓN</span></p>
    <img class="mark" src="/brand/jujuydev-logo-white.webp" alt="" width="443" height="120" loading="lazy" decoding="async" />
    <div class="info">
      <p class="mono">ROAD TO SOLAR TRAIN HACKATHON</p>
      <p class="mono">CIERRE · {deadline}</p>
      <p class="mono">ONLINE · JUJUY · ARG</p>
    </div>
    <div class="trajectory" aria-hidden="true"></div>
    <p class="slogan mono">IDEAS QUE VIAJAN <b>MÁS LEJOS</b></p>
    <i class="shard" aria-hidden="true"></i>
  </div>

  <div class="perf" aria-hidden="true"></div>

  <div class="stub">
    <div class="stub-head">
      <span class="admit mono">ADMIT ONE</span>
      <span class="stub-brand"><img class="stub-logo" src="/brand/jujuydev-logo-white.webp" alt="jujuy.dev" width="443" height="120" loading="lazy" decoding="async" /></span>
    </div>
    <p class="no">N° <span class="dots"><i>·</i><i>·</i></span><span class="of">/{TICKETS_TOTAL}</span></p>
    <dl class="grid mono">
      <div><dt>VAGÓN</dt><dd>01</dd></div>
      <div><dt>ANDÉN</dt><dd>JUJ</dd></div>
      <div><dt>ASIENTO</dt><dd>··</dd></div>
      <div><dt>GATE</dt><dd>PRE</dd></div>
      <div class="full"><dt>HACKER ID</dt><dd>JDV-2026-····</dd></div>
    </dl>
    <div class="codes">
      <svg class="barcode" viewBox="0 0 120 28" aria-hidden="true">
        {bars.map((b) => <rect x={b.x} y="0" width={b.w} height="28" fill="#0e0f12" />)}
      </svg>
      <span class={`qr ${isOpen ? 'qr-live' : ''}`} aria-hidden="true">
        <svg viewBox={`0 0 ${N} ${N}`} shape-rendering="crispEdges">
          {cells.map(([x, y]) => <rect x={x} y={y} width="1" height="1" fill="#0e0f12" />)}
          <rect x="7.5" y="7.5" width="6" height="6" fill="#f2f0ea" />
          <rect x="8.5" y="8.5" width="4" height="4" fill="#0b1d3a" />
          <rect x="9.5" y="9.5" width="2" height="2" fill="#ff5a1f" />
        </svg>
      </span>
    </div>
    <p class="legal mono">UNAUTHORISED RESALE PROHIBITED · VÁLIDO SOLO CON RESIDENCIA EN JUJUY</p>
    <i class="stripe" aria-hidden="true"></i>
  </div>
</div>

<style>
  .ticket {
    --body-h: 360px;
    --stub-h: 260px;
    position: relative;
    width: 340px;
    max-width: 100%;
    height: calc(var(--body-h) + var(--stub-h));
    display: flex;
    flex-direction: column;
    border-radius: var(--r-lg);
    overflow: hidden;
    isolation: isolate;
    background: var(--navy-900);
    --hole: radial-gradient(circle var(--notch) at 0 var(--body-h), transparent 98%, #000 100%),
      radial-gradient(circle var(--notch) at 100% var(--body-h), transparent 98%, #000 100%);
    -webkit-mask: var(--hole);
    -webkit-mask-composite: source-in;
    mask: var(--hole);
    mask-composite: intersect;
  }

  /* ───────── Cuerpo: foil solar sobre la Quebrada ───────── */
  .body {
    position: relative;
    height: var(--body-h);
    flex: none;
    background: var(--navy-900);
    color: var(--white);
    overflow: hidden;
    isolation: isolate;
  }
  .art {
    position: absolute;
    inset: 0;
    isolation: isolate;
    z-index: 0;
  }
  .art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
    filter: grayscale(1) contrast(1.15) brightness(0.95);
  }
  .tint {
    position: absolute;
    inset: 0;
  }
  .tint.hi {
    background: var(--orange-500);
    mix-blend-mode: multiply;
  }
  .tint.lo {
    background: var(--navy-800);
    mix-blend-mode: screen;
  }
  .foil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        115deg,
        rgba(255, 255, 255, 0) 25%,
        rgba(255, 138, 61, 0.32) 40%,
        rgba(255, 255, 255, 0.6) 47%,
        rgba(120, 90, 255, 0.35) 53%,
        rgba(27, 58, 107, 0.4) 58%,
        rgba(255, 255, 255, 0) 72%
      );
    background-size: 240% 100%;
    background-position: calc(var(--sheen, 18) * 1%) 0;
    mix-blend-mode: screen;
    transition: background-position var(--dur-slow) var(--ease-out);
  }
  .foil-gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
    z-index: 1;
    pointer-events: none;
  }
  .body.gl-on .foil-gl {
    display: block;
  }
  .body.gl-on .art,
  .body.gl-on .foil {
    display: none;
  }
  .grain {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0.16;
    mix-blend-mode: overlay;
    pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='160' height='160' filter='url(%23n)'/></svg>");
  }
  .frame {
    position: absolute;
    inset: 10px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: var(--r-md);
    pointer-events: none;
    z-index: 3;
  }
  .word,
  .mark,
  .info,
  .trajectory,
  .slogan,
  .shard {
    z-index: 4;
  }
  .word {
    position: absolute;
    top: 26px;
    left: 24px;
    margin: 0;
    font: 900 40px/0.95 var(--font-display);
    letter-spacing: -0.02em;
    display: flex;
    flex-direction: column;
    text-shadow: 0 2px 18px rgba(6, 15, 34, 0.55);
  }
  .mark {
    position: absolute;
    right: 24px;
    top: 24px;
    height: 22px;
    width: auto;
    filter: drop-shadow(0 2px 8px rgba(6, 15, 34, 0.6));
  }
  .info {
    position: absolute;
    left: 24px;
    bottom: 70px;
  }
  .mono {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.08em;
    line-height: 1.5;
    margin: 0;
  }
  .info .mono {
    color: rgba(255, 255, 255, 0.88);
    text-shadow: 0 1px 8px rgba(6, 15, 34, 0.7);
  }
  .trajectory {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 54px;
    border-top: 2px dotted var(--orange-400);
  }
  .slogan {
    position: absolute;
    left: 24px;
    bottom: 26px;
    font-size: 10px;
    text-shadow: 0 1px 8px rgba(6, 15, 34, 0.7);
  }
  .slogan b {
    color: var(--orange-300);
  }
  .shard {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 48px;
    height: 48px;
    background: var(--orange-500);
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
  }

  /* ───────── Perforación ───────── */
  .perf {
    position: absolute;
    left: 20px;
    right: 20px;
    top: var(--body-h);
    border-top: 2px dashed rgba(255, 255, 255, 0.55);
    z-index: 5;
    pointer-events: none;
  }

  /* ───────── Stub: boarding pass en papel térmico ───────── */
  .stub {
    position: relative;
    flex: 1;
    background:
      repeating-linear-gradient(to bottom, transparent 0 11px, rgba(201, 205, 211, 0.5) 11px 12px),
      var(--paper);
    color: var(--ink-950);
    padding: 20px 24px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    overflow: hidden;
  }
  .stub-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .admit {
    font-weight: 700;
    letter-spacing: 0.16em;
    font-size: 11px;
  }
  .stub-brand {
    display: inline-flex;
    align-items: center;
    padding: 4px 7px;
    border-radius: 3px;
    background: var(--navy-900);
    line-height: 0;
  }
  .stub-logo {
    height: 11px;
    width: auto;
    display: block;
  }
  .no {
    margin: 0;
    font: 700 var(--fs-ticket-no) / var(--lh-ticket-no) var(--font-display);
    color: var(--ink-950);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .no .of {
    font-size: 0.55em;
    color: var(--ink-600);
  }
  .dots i {
    font-style: normal;
    color: var(--orange-500);
    animation: pulse 1.6s ease-in-out infinite;
  }
  .dots i:nth-child(2) {
    animation-delay: 0.3s;
  }
  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }
  .grid {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px 16px;
  }
  .grid div {
    display: flex;
    gap: 6px;
    align-items: baseline;
  }
  .grid .full {
    grid-column: 1 / -1;
  }
  dt {
    font-size: 9px;
    color: var(--ink-600);
    letter-spacing: 0.08em;
  }
  dd {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
  }
  .codes {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }
  .barcode {
    width: 120px;
    height: 28px;
  }
  .qr {
    position: relative;
    width: 56px;
    height: 56px;
    display: block;
  }
  .qr svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .legal {
    font-size: 8px;
    color: var(--ink-600);
    letter-spacing: 0.04em;
  }
  .stripe {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 6px;
    background: var(--orange-500);
  }

  /* ───────── Desktop: horizontal 880×320 ───────── */
  @media (min-width: 1024px) {
    .ticket {
      --body-w: 600px;
      width: 880px;
      height: 320px;
      flex-direction: row;
      --hole: radial-gradient(circle var(--notch) at var(--body-w) 0, transparent 98%, #000 100%),
        radial-gradient(circle var(--notch) at var(--body-w) 100%, transparent 98%, #000 100%);
    }
    .body {
      width: var(--body-w);
      height: 100%;
    }
    .art img {
      object-position: 50% 40%;
    }
    .perf {
      left: var(--body-w);
      right: auto;
      top: 20px;
      bottom: 20px;
      height: auto;
      border-top: 0;
      border-left: 2px dashed var(--ink-400);
    }
    .word {
      flex-direction: column;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      top: 24px;
      height: 272px;
      left: 26px;
      font-size: 33px;
      justify-content: flex-start;
      gap: 6px;
    }
    .word span {
      display: block;
    }
    .mark {
      right: 28px;
      top: 26px;
      height: 24px;
    }
    .info {
      left: 130px;
      bottom: 92px;
    }
    .trajectory {
      left: 130px;
      right: 0;
      bottom: 68px;
    }
    .slogan {
      left: 130px;
      bottom: 36px;
    }
    .stub {
      padding: 18px 24px 16px;
      gap: 4px;
      clip-path: polygon(
        0 0,
        calc(100% - var(--chamfer)) 0,
        100% var(--chamfer),
        100% calc(100% - var(--chamfer)),
        calc(100% - var(--chamfer)) 100%,
        0 100%
      );
    }
    .no {
      font-size: 40px;
    }
    .stripe {
      left: auto;
      top: 0;
      bottom: 0;
      width: 6px;
      height: auto;
    }
  }

  /* Capas fantasma: solo forma y material, sin texto duplicado */
  .ghost .word,
  .ghost .mark,
  .ghost .info,
  .ghost .slogan,
  .ghost .stub-head,
  .ghost .no,
  .ghost .grid,
  .ghost .codes,
  .ghost .legal {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .dots i {
      animation: none;
    }
    .foil {
      transition: none;
    }
  }
</style>
