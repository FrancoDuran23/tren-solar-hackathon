---
import { config, TICKETS_TOTAL } from '../config';

interface Props {
  /** Capa fantasma del stack: mismo markup, aria-hidden, sin canvas WebGPU */
  ghost?: boolean;
}
const { ghost = false } = Astro.props;
/* ids únicos por instancia (el stack renderiza 3 tickets) */
const uid = Math.random().toString(36).slice(2, 7);

const isOpen = config.registration === 'open' && !!config.lumaUrl;
const deadline = config.deadline
  ? new Date(config.deadline.iso).toLocaleDateString('es-AR')
  : 'POR CONFIRMAR';

/* Barcode estilizado determinista (decorativo) */
const bars: { x: number; w: number }[] = [];
{
  let x = 0;
  let seed = 7;
  while (x < 118) {
    seed = (seed * 31 + 11) % 97;
    const w = 1 + (seed % 3);
    if (seed % 5 !== 0) bars.push({ x, w });
    x += w + 1 + (seed % 2);
  }
}

/* QR decorativo 21x21 determinista; finder patterns en 3 esquinas */
const N = 21;
const cells: [number, number][] = [];
{
  let s = 42;
  const finder = (r: number, c: number) => {
    const inF = (a: number, b: number) => a >= 0 && a < 7 && b >= 0 && b < 7;
    const fr = r < 7 ? r : r - (N - 7);
    const fc = c < 7 ? c : c - (N - 7);
    if (!((r < 7 && c < 7) || (r < 7 && c >= N - 7) || (r >= N - 7 && c < 7))) return null;
    if (!inF(fr, fc)) return null;
    const ring = Math.max(Math.abs(fr - 3), Math.abs(fc - 3));
    return ring !== 2;
  };
  for (let r = 0; r < N; r++)
    for (let c = 0; c < N; c++) {
      const f = finder(r, c);
      s = (s * 1103515245 + 12345) & 0x7fffffff;
      const on = f === null ? (s >> 8) % 2 === 0 : f;
      if (on) cells.push([c, r]);
    }
}
---

<div class:list={['ticket', { ghost }]} aria-hidden={ghost ? 'true' : undefined} data-ticket>
  <div class="body" data-body>
    <!-- Material (fallback sin WebGPU): plata cepillada + velo holográfico + guilloché + sheen -->
    <div class="metal" aria-hidden="true"></div>
    <div class="holo" aria-hidden="true"></div>
    <div class="spark" aria-hidden="true"></div>
    <div class="etch" aria-hidden="true"></div>
    <div class="foil" aria-hidden="true"></div>
    {!ghost && <canvas class="foil-gl" data-foil-gl aria-hidden="true"></canvas>}
    <div class="grain" aria-hidden="true"></div>
    <div class="frame" aria-hidden="true"></div>

    <p class="word" aria-hidden="true"><span>HACKATÓN</span><span>TREN SOLAR</span></p>
    <!-- Motif: el Tren Solar (dúo) en line-art sobre la plata, estilo inset LABITCONF. Sin foto. -->
    <svg class="motif" viewBox="0 0 420 100" aria-hidden="true" fill="none" stroke-linejoin="round" stroke-linecap="round">
      <defs>
        <clipPath id={`tsA-${uid}`}><path d="M46 12 H178 Q186 12 186 20 V78 H12 V54 Q12 26 46 12 Z" /></clipPath>
        <clipPath id={`tsB-${uid}`}><path d="M374 12 H242 Q234 12 234 20 V78 H408 V54 Q408 26 374 12 Z" /></clipPath>
      </defs>
      <!-- vía -->
      <path class="m-rail" d="M0 93 H420" />
      <path class="m-ties" d="M8 96 V90 M26 96 V90 M44 96 V90 M62 96 V90 M80 96 V90 M98 96 V90 M116 96 V90 M134 96 V90 M152 96 V90 M170 96 V90 M188 96 V90 M206 96 V90 M224 96 V90 M242 96 V90 M260 96 V90 M278 96 V90 M296 96 V90 M314 96 V90 M332 96 V90 M350 96 V90 M368 96 V90 M386 96 V90 M404 96 V90" />
      <!-- bogies -->
      <g class="m-bogie">
        <rect x="40" y="78" width="40" height="7" rx="2" /><rect x="138" y="78" width="40" height="7" rx="2" />
        <rect x="242" y="78" width="40" height="7" rx="2" /><rect x="340" y="78" width="40" height="7" rx="2" />
        <circle cx="50" cy="87" r="5" /><circle cx="70" cy="87" r="5" /><circle cx="148" cy="87" r="5" /><circle cx="168" cy="87" r="5" />
        <circle cx="252" cy="87" r="5" /><circle cx="272" cy="87" r="5" /><circle cx="350" cy="87" r="5" /><circle cx="370" cy="87" r="5" />
      </g>
      <!-- coche A (cabina adelante, izquierda) -->
      <g clip-path={`url(#tsA-${uid})`}>
        <rect class="m-body" x="12" y="12" width="174" height="66" />
        <rect class="m-skirt" x="12" y="68" width="174" height="10" />
        <path class="m-skirt" d="M12 78 V48 L44 62 L70 68 V78 Z" />
        <!-- banda de ventanales alta: del faldón casi al techo -->
        <rect class="m-glass" x="58" y="24" width="124" height="40" rx="2" />
        <path class="m-pillar" d="M98 24 V64 M138 24 V64" />
        <!-- cabina: ventana lateral + parabrisas + máscara navy -->
        <rect class="m-glass" x="42" y="24" width="12" height="40" rx="1.5" />
        <path class="m-glass" d="M18 40 Q22 22 46 14 V34 Q30 36 18 46 Z" />
        <path class="m-mask" d="M12 54 Q12 44 18 40 L30 38 V66 H12 Z" />
        <circle class="m-lamp" cx="16" cy="58" r="2" /><circle class="m-lamp" cx="24" cy="58" r="2" />
        <path class="m-m" d="M14 65 l3.5 -5 l2.5 3 l2.5 -3 l3.5 5" />
        <rect class="m-roof" x="84" y="8" width="36" height="5" rx="1" />
        <rect class="m-roof" x="130" y="9" width="30" height="4" rx="1" />
      </g>
      <path class="m-line" d="M46 12 H178 Q186 12 186 20 V78 H12 V54 Q12 26 46 12 Z" />
      <!-- fuelle -->
      <rect class="m-bellows" x="186" y="18" width="48" height="56" />
      <!-- coche B (cabina atrás, derecha), espejo -->
      <g clip-path={`url(#tsB-${uid})`}>
        <rect class="m-body" x="234" y="12" width="174" height="66" />
        <rect class="m-skirt" x="234" y="68" width="174" height="10" />
        <path class="m-skirt" d="M408 78 V48 L376 62 L350 68 V78 Z" />
        <rect class="m-glass" x="238" y="24" width="124" height="40" rx="2" />
        <path class="m-pillar" d="M282 24 V64 M322 24 V64" />
        <rect class="m-glass" x="366" y="24" width="12" height="40" rx="1.5" />
        <path class="m-glass" d="M402 40 Q398 22 374 14 V34 Q390 36 402 46 Z" />
        <path class="m-mask" d="M408 54 Q408 44 402 40 L390 38 V66 H408 Z" />
        <circle class="m-lamp" cx="404" cy="58" r="2" /><circle class="m-lamp" cx="396" cy="58" r="2" />
        <rect class="m-roof" x="300" y="8" width="36" height="5" rx="1" />
        <rect class="m-roof" x="260" y="9" width="30" height="4" rx="1" />
      </g>
      <path class="m-line" d="M374 12 H242 Q234 12 234 20 V78 H408 V54 Q408 26 374 12 Z" />
      <!-- sol de la Quebrada asomando detrás del dúo -->
    </svg>
    <i class="orbit" aria-hidden="true"></i>
    <span class="seal" aria-hidden="true">
      <img class="mark" src="/brand/jujuydev-logo-white.webp" alt="" width="443" height="120" loading="lazy" decoding="async" />
    </span>
    <div class="info">
      <p class="mono">RUMBO A LA HACKATÓN TREN SOLAR</p>
      <p class="mono">CIERRE · {deadline}</p>
      <p class="mono">ONLINE · JUJUY · ARG</p>
    </div>
    <div class="trajectory" aria-hidden="true"></div>
    <p class="slogan mono">IDEAS QUE VIAJAN <b>MÁS LEJOS</b></p>
    <i class="shard" aria-hidden="true"></i>
  </div>

  <div class="perf" aria-hidden="true"></div>

  <div class="stub">
    <div class="stub-head">
      <span class="admit"><i aria-hidden="true"></i>ADMIT ONE</span>
      <span class="stub-brand"><img class="stub-logo" src="/brand/jujuydev-logo-white.webp" alt="jujuy.dev" width="443" height="120" loading="lazy" decoding="async" /></span>
    </div>
    <p class="no"><span class="no-label mono">N°</span> <span class="dots"><i>·</i><i>·</i></span><span class="of">/{TICKETS_TOTAL}</span></p>
    <dl class="grid mono">
      <div class="full dest"><dt>DESTINO</dt><dd>HACKATÓN TREN SOLAR</dd></div>
      <div><dt>VAGÓN</dt><dd>01</dd></div>
      <div><dt>ANDÉN</dt><dd>JUJ</dd></div>
      <div><dt>ASIENTO</dt><dd>··</dd></div>
      <div><dt>GATE</dt><dd>HTS</dd></div>
      <div class="full"><dt>HACKER ID</dt><dd>JDV-2026-····</dd></div>
    </dl>
    <div class="codes">
      <svg class="barcode" viewBox="0 0 120 28" aria-hidden="true">
        {bars.map((b) => <rect x={b.x} y="0" width={b.w} height="28" fill="#0e0f12" />)}
      </svg>
      <span class={`qr ${isOpen ? 'qr-live' : ''}`} aria-hidden="true">
        <svg viewBox={`0 0 ${N} ${N}`} shape-rendering="crispEdges">
          {cells.map(([x, y]) => <rect x={x} y={y} width="1" height="1" fill="#0e0f12" />)}
          <rect x="7.5" y="7.5" width="6" height="6" fill="#f2f0ea" />
          <rect x="8.5" y="8.5" width="4" height="4" fill="#0b1d3a" />
          <rect x="9.5" y="9.5" width="2" height="2" fill="#ff5a1f" />
        </svg>
      </span>
    </div>
    <p class="legal mono">UNAUTHORISED RESALE PROHIBITED · VÁLIDO SOLO CON RESIDENCIA EN JUJUY</p>
    <i class="stripe" aria-hidden="true"></i>
  </div>
</div>

<style>
  .ticket {
    --body-h: 320px;
    --stub-h: 300px;
    /* Tinta sobre plata: navy, con un filo blanco de grabado */
    --ink-on-metal: var(--navy-950);
    --emboss: 0 1px 0 rgba(255, 255, 255, 0.55);
    position: relative;
    width: 340px;
    max-width: 100%;
    height: calc(var(--body-h) + var(--stub-h));
    display: flex;
    flex-direction: column;
    border-radius: var(--r-lg);
    overflow: hidden;
    isolation: isolate;
    background: var(--navy-900);
    --hole: radial-gradient(circle var(--notch) at 0 var(--body-h), transparent 98%, #000 100%),
      radial-gradient(circle var(--notch) at 100% var(--body-h), transparent 98%, #000 100%);
    -webkit-mask: var(--hole);
    -webkit-mask-composite: source-in;
    mask: var(--hole);
    mask-composite: intersect;
  }

  /* ───────── Cuerpo: lámina de plata cepillada con holograma ───────── */
  .body {
    position: relative;
    height: var(--body-h);
    flex: none;
    background: #aeb5bf;
    color: var(--ink-on-metal);
    overflow: hidden;
    isolation: isolate;
  }
  .metal,
  .holo,
  .spark,
  .etch,
  .foil,
  .foil-gl,
  .grain,
  .frame {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* Cromo: bandas claras/oscuras de un entorno reflejado + veta horizontal (turbulencia anisótropa) */
  .metal {
    z-index: 0;
    background:
      radial-gradient(120% 90% at 12% 0%, rgba(255, 255, 255, 0.32), rgba(255, 255, 255, 0) 55%),
      linear-gradient(
        112deg,
        #747d89 0%,
        #c6ccd4 13%,
        #eef1f5 22%,
        #a7afb9 34%,
        #717a86 46%,
        #cfd4db 58%,
        #f2f4f7 66%,
        #aab1bb 78%,
        #767f8b 90%,
        #9aa2ad 100%
      );
  }
  .metal::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.42;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='320' height='320'><filter id='b'><feTurbulence type='fractalNoise' baseFrequency='0.012 0.9' numOctaves='3' seed='7'/><feColorMatrix values='0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 1.6 -0.3'/></filter><rect width='320' height='320' filter='url(%23b)'/></svg>");
    background-size: 320px 320px;
  }
  .metal::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0) 18%),
      linear-gradient(0deg, rgba(6, 15, 34, 0.22), rgba(6, 15, 34, 0) 26%);
  }
  /* Velo holográfico: arcoíris pastel que tiñe el metal conservando su luminancia; deriva lento */
  .holo {
    z-index: 1;
    width: 280%;
    opacity: 0.54;
    mix-blend-mode: color;
    /* Los stops grises (#c9ced6) son neutros bajo blend "color": dejan ver la plata entre zonas iridiscentes */
    background: linear-gradient(
      108deg,
      #ff9fb4 0%,
      #c9ced6 9%,
      #ffd59c 17%,
      #e3ffa3 25%,
      #c9ced6 35%,
      #9ffbe1 43%,
      #9ccbff 51%,
      #c9ced6 61%,
      #c7a8ff 69%,
      #ff9fdc 77%,
      #c9ced6 88%,
      #ff9fb4 100%
    );
    animation: holo-drift 18s ease-in-out infinite alternate;
  }
  .ghost .holo {
    animation: none;
    transform: translateX(-22%);
  }
  /* Punto caliente iridiscente (holograma de seguridad) fijo en la esquina del guilloché */
  .spark {
    z-index: 1;
    opacity: 0.6;
    mix-blend-mode: color;
    background: conic-gradient(
      from 210deg at 78% 92%,
      rgba(255, 170, 190, 0.9),
      rgba(255, 225, 160, 0.9),
      rgba(190, 255, 170, 0.9),
      rgba(160, 240, 255, 0.9),
      rgba(170, 180, 255, 0.9),
      rgba(240, 170, 255, 0.9),
      rgba(255, 170, 190, 0.9)
    );
    mask-image: radial-gradient(60% 80% at 78% 92%, #000 10%, rgba(0, 0, 0, 0.3) 55%, transparent 80%);
  }
  @keyframes holo-drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-64%);
    }
  }
  /* Guilloché grabado: anillos concéntricos que salen de la esquina inferior derecha */
  .etch {
    z-index: 1;
    opacity: 0.55;
    mix-blend-mode: overlay;
    background: repeating-radial-gradient(
      ellipse 560px 480px at 84% 118%,
      rgba(255, 255, 255, 0) 0 8px,
      rgba(255, 255, 255, 0.85) 8px 9px,
      rgba(6, 15, 34, 0.35) 9px 10px,
      rgba(255, 255, 255, 0) 10px 14px
    );
    mask-image: radial-gradient(70% 90% at 84% 118%, #000 25%, rgba(0, 0, 0, 0.35) 65%, transparent 92%);
  }
  /* Sheen especular que sigue al puntero (--sheen) con un borde de difracción */
  .foil {
    z-index: 1;
    background: linear-gradient(
      115deg,
      rgba(255, 255, 255, 0) 30%,
      rgba(255, 150, 190, 0.22) 40%,
      rgba(255, 255, 255, 0.62) 47%,
      rgba(255, 255, 255, 0.9) 50%,
      rgba(255, 255, 255, 0.5) 53%,
      rgba(150, 205, 255, 0.28) 59%,
      rgba(255, 255, 255, 0) 70%
    );
    background-size: 240% 100%;
    background-position: calc(var(--sheen, 18) * 1%) 0;
    transition: background-position var(--dur-slow) var(--ease-out);
  }
  .foil-gl {
    width: 100%;
    height: 100%;
    display: none;
    z-index: 1;
  }
  .body.gl-on .foil-gl {
    display: block;
  }
  .body.gl-on .metal,
  .body.gl-on .holo,
  .body.gl-on .spark,
  .body.gl-on .etch,
  .body.gl-on .foil {
    display: none;
  }
  .grain {
    z-index: 2;
    opacity: 0.14;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='160' height='160' filter='url(%23n)'/></svg>");
  }
  .body.gl-on .grain {
    opacity: 0.07;
  }
  /* Marco interior fino (Soul): línea navy con filo claro, como un bisel */
  .frame {
    inset: 10px;
    border: 1px solid rgba(11, 29, 58, 0.45);
    border-radius: var(--r-md);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.45),
      inset 0 0 0 1px rgba(255, 255, 255, 0.35);
    z-index: 3;
  }
  .word,
  .motif,
  .orbit,
  .seal,
  .info,
  .trajectory,
  .slogan,
  .shard {
    z-index: 4;
  }
  /* Motif del Tren Solar: tinta navy grabada sobre la plata, faldón naranja, banda de ventanales alta */
  .motif {
    position: absolute;
    left: 24px;
    top: 118px;
    width: 186px;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 1px 0 rgba(255, 255, 255, 0.55));
  }
  .motif .m-body { fill: rgba(255, 255, 255, 0.82); }
  .motif .m-line { stroke: var(--navy-950); stroke-width: 1.6; }
  .motif .m-glass { fill: var(--navy-950); }
  .motif .m-pillar { stroke: rgba(255, 255, 255, 0.95); stroke-width: 2.2; }
  .motif .m-skirt { fill: var(--orange-500); }
  .motif .m-mask { fill: var(--navy-950); }
  .motif .m-lamp { fill: #fff6e0; }
  .motif .m-m { stroke: var(--orange-500); stroke-width: 1.6; }
  .motif .m-roof { fill: rgba(11, 29, 58, 0.55); }
  .motif .m-bellows { fill: var(--navy-900); }
  .motif .m-bogie { fill: var(--navy-950); }
  .motif .m-rail { stroke: var(--navy-950); stroke-width: 1.6; }
  .motif .m-ties { stroke: rgba(11, 29, 58, 0.55); stroke-width: 1.2; }
  .word {
    position: absolute;
    top: 24px;
    left: 24px;
    margin: 0;
    font: 900 31px/0.98 var(--font-display);
    letter-spacing: -0.02em;
    display: flex;
    flex-direction: column;
    color: var(--ink-on-metal);
    text-shadow: var(--emboss);
  }
  /* Sello: disco navy con el logo en negativo + órbita naranja detrás (poster) */
  .seal {
    position: absolute;
    right: 24px;
    top: 112px;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: radial-gradient(circle at 34% 28%, var(--navy-700), var(--navy-900) 55%, var(--navy-950) 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.28),
      inset 0 -10px 18px rgba(6, 15, 34, 0.6),
      0 10px 24px rgba(6, 15, 34, 0.35);
  }
  .seal::after {
    content: '';
    position: absolute;
    inset: 7px;
    border-radius: 50%;
    border: 1px dashed rgba(255, 255, 255, 0.28);
  }
  .mark {
    position: relative;
    height: 20px;
    width: auto;
    display: block;
  }
  .orbit {
    position: absolute;
    right: 2px;
    top: 128px;
    width: 160px;
    height: 64px;
    border: 1.5px solid var(--orange-500);
    border-radius: 50%;
    transform: rotate(-22deg);
    z-index: 3;
  }
  .orbit::after {
    content: '';
    position: absolute;
    left: 8px;
    top: 6px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--orange-500);
    box-shadow: 0 0 8px rgba(255, 90, 31, 0.6);
  }
  .info {
    position: absolute;
    left: 24px;
    bottom: 70px;
  }
  .mono {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.08em;
    line-height: 1.5;
    margin: 0;
  }
  .info .mono {
    color: var(--ink-on-metal);
    font-weight: 700;
    text-shadow: var(--emboss);
  }
  .trajectory {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 54px;
    border-top: 2px dotted var(--orange-500);
  }
  .slogan {
    position: absolute;
    left: 24px;
    bottom: 26px;
    font-size: 10px;
    font-weight: 700;
    color: var(--ink-on-metal);
    text-shadow: var(--emboss);
  }
  .slogan b {
    color: var(--orange-600);
  }
  .shard {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 48px;
    height: 48px;
    background: var(--orange-500);
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
  }

  /* ───────── Perforación ───────── */
  .perf {
    position: absolute;
    left: 20px;
    right: 20px;
    top: var(--body-h);
    border-top: 2px dashed var(--ink-400);
    z-index: 5;
    pointer-events: none;
  }

  /* ───────── Stub: boarding pass en papel térmico ───────── */
  .stub {
    position: relative;
    flex: 1;
    background: linear-gradient(180deg, #f8f6f1 0%, var(--paper) 100%);
    color: var(--ink-950);
    padding: 18px 24px 16px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    overflow: hidden;
  }
  .stub-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .admit {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font: 700 12px/1 var(--font-display);
    letter-spacing: 0.16em;
    color: var(--ink-950);
  }
  .admit i {
    width: 10px;
    height: 10px;
    background: var(--orange-500);
    clip-path: polygon(0 0, 100% 0, 100% 100%);
  }
  .stub-brand {
    display: inline-flex;
    align-items: center;
    padding: 4px 7px;
    border-radius: 3px;
    background: var(--navy-900);
    line-height: 0;
  }
  .stub-logo {
    height: 11px;
    width: auto;
    display: block;
