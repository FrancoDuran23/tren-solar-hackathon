---
import { config, TICKETS_TOTAL } from '../config';

interface Props {
  /** Capa fantasma del stack: mismo markup, aria-hidden, sin canvas WebGPU */
  ghost?: boolean;
}
const { ghost = false } = Astro.props;

const isOpen = config.registration === 'open' && !!config.lumaUrl;
const deadline = config.deadline
  ? new Date(config.deadline.iso).toLocaleDateString('es-AR')
  : 'POR CONFIRMAR';

/* Barcode estilizado determinista (decorativo) */
const bars: { x: number; w: number }[] = [];
{
  let x = 0;
  let seed = 7;
  while (x < 118) {
    seed = (seed * 31 + 11) % 97;
    const w = 1 + (seed % 3);
    if (seed % 5 !== 0) bars.push({ x, w });
    x += w + 1 + (seed % 2);
  }
}

/* QR decorativo 21x21 determinista; finder patterns en 3 esquinas */
const N = 21;
const cells: [number, number][] = [];
{
  let s = 42;
  const finder = (r: number, c: number) => {
    const inF = (a: number, b: number) => a >= 0 && a < 7 && b >= 0 && b < 7;
    const fr = r < 7 ? r : r - (N - 7);
    const fc = c < 7 ? c : c - (N - 7);
    if (!((r < 7 && c < 7) || (r < 7 && c >= N - 7) || (r >= N - 7 && c < 7))) return null;
    if (!inF(fr, fc)) return null;
    const ring = Math.max(Math.abs(fr - 3), Math.abs(fc - 3));
    return ring !== 2;
  };
  for (let r = 0; r < N; r++)
    for (let c = 0; c < N; c++) {
      const f = finder(r, c);
      s = (s * 1103515245 + 12345) & 0x7fffffff;
      const on = f === null ? (s >> 8) % 2 === 0 : f;
      if (on) cells.push([c, r]);
    }
}
---

<!--
  Ticket "Hackatón Tren Solar" según las refs de Franco (docs/refs/ref-ticket-franco-a/b.jpg):
  cuerpo noche con el Tren Solar real en la Quebrada al atardecer, título display grande,
  franja holográfica abajo con el sello circular jujuy.dev, y stub oscuro Admit One con
  grilla, barcode y QR. Chanfles metálicos en las esquinas exteriores.
-->
<div class:list={['ticket', { ghost }]} aria-hidden={ghost ? 'true' : undefined} data-ticket>
  <div class="body">
    <!-- Paisaje: Tren Solar en la Quebrada (asset real del repo), oscurecido hacia el título -->
    <img class="scene" src="/brand/solar-train-quebrada.jpg" alt="" width="1024" height="775" loading="lazy" decoding="async" />
    <i class="shade" aria-hidden="true"></i>
    <i class="grain" aria-hidden="true"></i>

    <p class="corner corner-tl mono"><img src="/brand/jujuydev-logo-white.webp" alt="" width="443" height="120" loading="lazy" decoding="async" />JUJUY<i>/</i>ARGENTINA</p>
    <p class="corner corner-tr mono"><span>ONLINE</span><span>JUJUY · ARG</span><span>{TICKETS_TOTAL} TICKETS</span></p>

    <h3 class="title">
      <span class="t1">Hackatón</span>
      <span class="t2">Tren Solar</span>
    </h3>
    <p class="tagline mono">IDEAS QUE VIAJAN MÁS LEJOS</p>

    <p class="credit mono"><i aria-hidden="true"></i><span>JUJUY.DEV<br /><b>COMUNIDAD DE DESARROLLADORES</b></span></p>

    <!-- Franja holográfica (foil vgpu con fallback CSS) -->
    <div class="strip" data-body>
      <i class="holo" aria-hidden="true"></i>
      <i class="sheen" aria-hidden="true"></i>
      {!ghost && <canvas class="foil-gl" data-foil-gl aria-hidden="true"></canvas>}
      <p class="strip-text mono">
        <span>RUMBO A LA HACKATÓN TREN SOLAR</span>
        <span>CIERRE · {deadline}</span>
        <span>ONLINE · JUJUY · ARG</span>
      </p>
    </div>

    <!-- Sello circular jujuy.dev, montado sobre el borde de la franja -->
    <span class="seal" aria-hidden="true">
      <img class="mark" src="/brand/jujuydev-logo-white.webp" alt="" width="443" height="120" loading="lazy" decoding="async" />
    </span>
  </div>

  <div class="perf" aria-hidden="true"></div>

  <div class="stub">
    <div class="stub-head">
      <span class="admit">ADMIT ONE<i aria-hidden="true">/</i></span>
      <svg class="orbit-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <circle cx="12" cy="12" r="5" /><path d="M3.5 15.5c3-1.2 9.8-4.6 16-10.4M4.5 8.5c-.6 3.4 7.8 7.9 15 7" />
      </svg>
    </div>
    <dl class="grid mono">
      <div class="full dest"><dt>DESTINO</dt><dd>HACKATÓN TREN SOLAR</dd><i aria-hidden="true"></i></div>
      <div><dt>VAGÓN</dt><dd>01</dd></div>
      <div><dt>ASIENTO</dt><dd><span class="dots"><i>·</i><i>·</i></span><small>/{TICKETS_TOTAL}</small></dd></div>
      <div><dt>GATE</dt><dd>HTS</dd></div>
      <div><dt>HACKER ID</dt><dd>JDV-2026-····</dd></div>
    </dl>
    <div class="codes">
      <svg class="barcode" viewBox="0 0 120 28" aria-hidden="true">
        {bars.map((b) => <rect x={b.x} y="0" width={b.w} height="28" fill="#f2f4f7" />)}
      </svg>
      <span class={`qr ${isOpen ? 'qr-live' : ''}`} aria-hidden="true">
        <svg viewBox={`0 0 ${N} ${N}`} shape-rendering="crispEdges">
          {cells.map(([x, y]) => <rect x={x} y={y} width="1" height="1" fill="#f2f4f7" />)}
          <rect x="7.5" y="7.5" width="6" height="6" fill="#0b0e16" />
          <rect x="8.5" y="8.5" width="4" height="4" fill="#f2f4f7" />
          <rect x="9.5" y="9.5" width="2" height="2" fill="#ff5a1f" />
        </svg>
      </span>
    </div>
    <p class="foot mono">JUJUY<i>/</i>ARGENTINA<span class="legal">UNAUTHORISED RESALE PROHIBITED · VÁLIDO SOLO CON RESIDENCIA EN JUJUY</span></p>
  </div>
</div>

<style>
  .ticket {
    --body-h: 364px;
    --stub-h: 256px;
    --edge: 14px;
    --night: #0b0e16;
    --night-2: #121726;
    position: relative;
    width: 340px;
    max-width: 100%;
    height: calc(var(--body-h) + var(--stub-h));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    isolation: isolate;
    color: var(--white);
    background: var(--night);
    /* Chanfles metálicos en las 4 esquinas + notches en la perforación */
    clip-path: polygon(
      var(--edge) 0, calc(100% - var(--edge)) 0, 100% var(--edge),
      100% calc(100% - var(--edge)), calc(100% - var(--edge)) 100%,
      var(--edge) 100%, 0 calc(100% - var(--edge)), 0 var(--edge)
    );
    --hole: radial-gradient(circle var(--notch) at 0 var(--body-h), transparent 98%, #000 100%),
      radial-gradient(circle var(--notch) at 100% var(--body-h), transparent 98%, #000 100%);
    -webkit-mask: var(--hole);
    -webkit-mask-composite: source-in;
    mask: var(--hole);
    mask-composite: intersect;
  }
  /* Filo metálico interior (bisel plateado fino) */
  .ticket::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 9;
    box-shadow:
      inset 0 0 0 1px rgba(214, 222, 236, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }
  .mono {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.14em;
    line-height: 1.4;
    margin: 0;
    text-transform: uppercase;
  }

  /* ───────── Cuerpo: noche en la Quebrada ───────── */
  .body {
    position: relative;
    height: var(--body-h);
    flex: none;
    overflow: hidden;
    isolation: isolate;
    background: var(--night);
  }
  .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 46%;
    filter: saturate(0.92) contrast(1.06);
  }
  .shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(11, 14, 22, 0.96) 0%, rgba(11, 14, 22, 0.78) 34%, rgba(11, 14, 22, 0.18) 62%, rgba(11, 14, 22, 0.08) 100%),
      linear-gradient(180deg, rgba(11, 14, 22, 0.7) 0%, rgba(11, 14, 22, 0) 32%, rgba(11, 14, 22, 0) 62%, rgba(11, 14, 22, 0.78) 100%);
  }
  .grain {
    position: absolute;
    inset: 0;
    opacity: 0.12;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='160' height='160' filter='url(%23n)'/></svg>");
  }
  .corner,
  .title,
  .tagline,
  .credit,
  .strip,
  .seal {
    position: absolute;
    z-index: 2;
  }
  .corner {
    top: 18px;
    color: rgba(255, 255, 255, 0.88);
    font-size: 9px;
  }
  .corner i {
    font-style: normal;
    color: var(--orange-500);
    margin: 0 8px;
  }
  .corner-tl {
    left: 20px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
  }
  .corner-tl img {
    height: 14px;
    width: auto;
    display: block;
  }
  .corner-tr {
    right: 20px;
    display: grid;
    justify-items: end;
    gap: 3px;
    padding-right: 10px;
    border-right: 2px solid var(--orange-500);
    text-align: right;
  }
  .title {
    left: 20px;
    top: 84px;
    margin: 0;
    display: grid;
    gap: 2px;
    font-family: var(--font-display);
    text-transform: uppercase;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.55);
  }
  .t1 {
    font-weight: 500;
    font-size: 20px;
    letter-spacing: 0.22em;
    line-height: 1;
    color: rgba(255, 255, 255, 0.92);
  }
  .t2 {
    font-weight: 900;
    font-size: 34px;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--white);
  }
  .tagline {
    left: 20px;
    top: 152px;
    font-size: 9px;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.78);
    padding-bottom: 10px;
  }
  .tagline::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 36px;
    height: 2px;
    background: var(--orange-500);
  }
  .credit {
    left: 20px;
    bottom: 86px;
    display: inline-flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 8px;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.8);
  }
  .credit b {
    font-weight: 400;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.12em;
  }
  .credit i {
    margin-top: 3px;
    width: 14px;
    height: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.7);
    position: relative;
  }
  .credit i::after {
    content: '';
    position: absolute;
    right: 0;
    top: -3px;
    width: 5px;
    height: 5px;
    border-top: 1px solid rgba(255, 255, 255, 0.7);
    border-right: 1px solid rgba(255, 255, 255, 0.7);
    transform: rotate(45deg);
  }

  /* Franja holográfica */
  .strip {
    left: 0;
    right: 0;
    bottom: 0;
    height: 72px;
    overflow: hidden;
    background: #d9dde6;
    isolation: isolate;
  }
  .holo {
    position: absolute;
    inset: 0;
    width: 220%;
    background: linear-gradient(
      100deg,
      #f3c9da 0%, #fff0c8 9%, #d6f6e0 18%, #c4e6ff 27%, #d9ccff 36%, #ffcde8 45%,
      #f6f7f9 52%, #ffe5c2 60%, #cdf2e4 68%, #c7dcff 77%, #e1cdff 86%, #f3c9da 100%
    );
    animation: holo-drift 16s ease-in-out infinite alternate;
  }
  .ghost .holo {
    animation: none;
    transform: translateX(-30%);
  }
  @keyframes holo-drift {
    from { transform: translateX(0); }
    to { transform: translateX(-52%); }
  }
  .sheen {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(115deg, rgba(255, 255, 255, 0) 32%, rgba(255, 255, 255, 0.85) 48%, rgba(255, 255, 255, 0) 64%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 30%, rgba(11, 14, 22, 0.1) 100%);
    background-size: 240% 100%, 100% 100%;
    background-position: calc(var(--sheen, 18) * 1%) 0, 0 0;
    transition: background-position var(--dur-slow) var(--ease-out);
  }
  .foil-gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
  }
  .strip.gl-on .foil-gl {
    display: block;
  }
  .strip.gl-on .holo,
  .strip.gl-on .sheen {
    display: none;
  }
  .strip-text {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    gap: 2px;
    font-size: 8px;
    letter-spacing: 0.2em;
    color: var(--navy-950);
    font-weight: 700;
    padding-left: 12px;
    border-left: 1px solid rgba(11, 29, 58, 0.55);
    z-index: 2;
  }
  .seal {
    right: 18px;
    bottom: 34px;
    width: 82px;
    height: 82px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    z-index: 3;
    background: radial-gradient(circle at 36% 30%, #1d2740, var(--night-2) 55%, #06080e 100%);
    box-shadow:
      0 0 0 2px rgba(226, 232, 240, 0.75),
      0 0 0 3px rgba(11, 14, 22, 0.8),
      0 10px 26px rgba(0, 0, 0, 0.55);
  }
  .seal::after {
    content: '';
    position: absolute;
    inset: 7px;
    border-radius: 50%;
    border: 1px dashed rgba(255, 255, 255, 0.32);
  }
  .mark {
    position: relative;
    height: 16px;
    width: auto;
    display: block;
  }

  /* ───────── Perforación ───────── */
  .perf {
    position: absolute;
    left: 22px;
    right: 22px;
    top: var(--body-h);
    border-top: 2px dashed rgba(214, 222, 236, 0.45);
    z-index: 5;
    pointer-events: none;
  }

  /* ───────── Stub Admit One: noche, grilla con hairlines ───────── */
  .stub {
    position: relative;
    flex: 1;
    background: linear-gradient(180deg, #11151f 0%, var(--night) 100%);
    padding: 18px 20px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
  }
  .stub-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .admit {
    font: 500 13px/1 var(--font-display);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--white);
  }
  .admit i {
    font-style: normal;
    color: var(--orange-500);
    margin-left: 10px;
  }
  .orbit-ic {
    width: 22px;
    height: 22px;
    color: rgba(255, 255, 255, 0.85);
  }
  .grid {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid rgba(214, 222, 236, 0.22);
  }
  .grid > div {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 8px 10px 9px;
    border-top: 1px solid rgba(214, 222, 236, 0.22);
    min-width: 0;
  }
  .grid > div:first-child {
    border-top: 0;
  }
  .grid > div:nth-child(2),
  .grid > div:nth-child(4) {
    border-right: 1px solid rgba(214, 222, 236, 0.22);
  }
  .grid .full {
    grid-column: 1 / -1;
  }
  .dest i {
    position: absolute;
    right: 12px;
    top: 50%;
    width: 16px;
    height: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.8);
  }
  .dest i::after {
    content: '';
    position: absolute;
    right: 0;
    top: -4px;
    width: 7px;
    height: 7px;
    border-top: 1px solid rgba(255, 255, 255, 0.8);
    border-right: 1px solid rgba(255, 255, 255, 0.8);
    transform: rotate(45deg);
  }
  dt {
    font-size: 8px;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.55);
  }
  dd {
    margin: 0;
    font: 500 15px/1.1 var(--font-display);
    letter-spacing: 0.04em;
    color: var(--white);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dest dd {
    font-size: 14px;
    padding-right: 28px;
  }
  dd small {
    font-size: 0.6em;
    color: rgba(255, 255, 255, 0.55);
    margin-left: 2px;
  }
  .dots i {
    font-style: normal;
    color: var(--orange-500);
    animation: pulse 1.6s ease-in-out infinite;
  }
  .dots i:nth-child(2) {
    animation-delay: 0.3s;
  }
  @keyframes pulse {
    50% { opacity: 0.25; }
  }
  .codes {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
  }
  .barcode {
    width: 150px;
    height: 34px;
  }
  .qr {
    position: relative;
    width: 52px;
    height: 52px;
    display: block;
  }
  .qr svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .foot {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 8px;
    letter-spacing: 0.22em;
    color: rgba(255, 255, 255, 0.78);
  }
  .foot i {
    font-style: normal;
    color: var(--orange-500);
  }
  .legal {
    margin-left: auto;
    font-size: 6.5px;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.4);
    text-align: right;
    max-width: 55%;
  }

  /* ───────── Desktop: horizontal 880×320 ───────── */
  @media (min-width: 1024px) {
    .ticket {
      --body-w: 566px;
      width: 880px;
      height: 320px;
      flex-direction: row;
      --hole: radial-gradient(circle var(--notch) at var(--body-w) 0, transparent 98%, #000 100%),
        radial-gradient(circle var(--notch) at var(--body-w) 100%, transparent 98%, #000 100%);
    }
    .body {
      width: var(--body-w);
      height: 100%;
    }
    .scene {
      object-position: 70% 40%;
    }
    .shade {
      background:
        linear-gradient(90deg, rgba(11, 14, 22, 0.97) 0%, rgba(11, 14, 22, 0.84) 30%, rgba(11, 14, 22, 0.22) 58%, rgba(11, 14, 22, 0.06) 100%),
        linear-gradient(180deg, rgba(11, 14, 22, 0.66) 0%, rgba(11, 14, 22, 0) 30%, rgba(11, 14, 22, 0) 64%, rgba(11, 14, 22, 0.7) 100%);
    }
    .corner {
      top: 20px;
    }
    .corner-tl {
      left: 26px;
    }
    .corner-tr {
      right: 26px;
    }
    .title {
      left: 26px;
      top: 86px;
    }
    .t1 {
      font-size: 24px;
      letter-spacing: 0.24em;
    }
    .t2 {
      font-size: 44px;
    }
    .tagline {
      top: 166px;
      font-size: 10px;
    }
    .credit {
      bottom: 96px;
      left: 26px;
    }
    .strip {
      height: 84px;
    }
    .strip-text {
      left: 26px;
      font-size: 9px;
    }
    .seal {
      right: 30px;
      bottom: 38px;
      width: 96px;
      height: 96px;
    }
    .mark {
      height: 19px;
    }
    .perf {
      left: var(--body-w);
      right: auto;
      top: 22px;
      bottom: 22px;
      border-top: 0;
      border-left: 2px dashed rgba(214, 222, 236, 0.45);
    }
    .stub {
      padding: 18px 22px 16px;
      gap: 10px;
    }
    .admit {
      font-size: 14px;
    }
    .grid > div {
      padding: 7px 10px 8px;
    }
    dd {
      font-size: 14px;
      letter-spacing: 0.02em;
    }
    .dest dd {
      font-size: 12px;
      padding-right: 26px;
    }
    .grid > div {
      padding: 6px 9px 7px;
    }
    .barcode {
      width: 150px;
      height: 32px;
    }
    .legal {
      font-size: 6px;
      max-width: 52%;
    }
    .qr {
      width: 50px;
      height: 50px;
    }
  }

  /* Capas fantasma: solo forma y material, sin texto duplicado */
  .ghost .corner,
  .ghost .title,
  .ghost .tagline,
  .ghost .credit,
  .ghost .strip-text,
  .ghost .mark,
  .ghost .stub-head,
  .ghost .grid,
  .ghost .codes,
  .ghost .foot {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .dots i,
    .holo {
      animation: none;
    }
    .sheen {
      transition: none;
    }
  }
</style>
