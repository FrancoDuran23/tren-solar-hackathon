---
import Ticket from './Ticket.astro';
import { copy } from '../content/copy';
import { dates } from '../content/dates';
import { config, TICKETS_TOTAL } from '../config';

const isOpen = config.registration === 'open' && !!config.lumaUrl;
const isClosed = config.registration === 'closed';
const state: 'open' | 'closed' | 'soon' = isClosed ? 'closed' : isOpen ? 'open' : 'soon';

const chip = state === 'open' ? 'Inscripción abierta' : `${TICKETS_TOTAL} tickets en juego`;
const assigned = Math.min(Math.max(config.ticketsAssigned, 0), TICKETS_TOTAL);
const free = TICKETS_TOTAL - assigned;
const seats = Array.from({ length: TICKETS_TOTAL }, (_, i) => i < assigned);
const ticketLabel = 'Ticket Hackatón Tren Solar · jujuy.dev, número por asignar de ' + TICKETS_TOTAL;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <!-- Cosmos del ticket (ref-b): espacio negro-azulado, planetas del arte del poster, curva
       de la Tierra con atmósfera iluminada y un destello naranja. Sin tren 3D: el tren vive
       en la foto del ticket. -->
  <!-- Cosmos + Tren Solar en la Quebrada, a tamaño de foto (sin recorte escalado).
       El navy cubre la izquierda para que el titular se lea; el naranja es el destello. -->
  <div class="backdrop" aria-hidden="true">
    <i class="sky"></i>
    <i class="stars"></i>
    <img class="cosmos" src="/brand/solar-train-sky.jpg" alt="" width="1024" height="512" loading="eager" decoding="async" />
    <img class="quebrada" src="/brand/solar-train-quebrada.jpg" alt="" width="1024" height="775" loading="eager" decoding="async" />
    <i class="flare"></i>
    <i class="navy"></i>
    <i class="grain"></i>
    <i class="shard shard-tl"></i>
    <i class="shard shard-br"></i>
    <i class="rail"></i>
  </div>

  <div class="wrap">
    <div class="copy">
      <h1 id="hero-title"><span class="vos">Y vos…</span> <span class="foil">¿te ganás<br />tu ticket?</span></h1>
      <p class="lead">
        {TICKETS_TOTAL} tickets a la Hackatón Tren Solar. Buildeá online, subí tu proyecto y subite al tren.
      </p>
      <div class="ctas">
        {state === 'open' && (
          <a class="cta cta-primary" href={config.lumaUrl!} target="_blank" rel="noopener noreferrer">
            Inscribite en Luma <span class="arrow" aria-hidden="true">→</span>
          </a>
        )}
        {state === 'soon' && (
          <a class="cta cta-primary" href="#tablero">
            {copy.cta.soon} <span class="arrow" aria-hidden="true">→</span>
          </a>
        )}
        {state === 'closed' && (
          <span class="cta cta-closed" role="link" aria-disabled="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1"/><path d="M5 7V5a3 3 0 0 1 6 0v2"/></svg>
            Inscripción cerrada
          </span>
        )}
        {state === 'closed'
          ? <a class="cta cta-secondary" href="#proyectos">Ver proyectos</a>
          : <a class="cta cta-secondary" href="#como">Ver cómo funciona</a>}
      </div>
      <dl class="facts mono">
        <div><dt>BUILD</dt><dd>{dates.buildMono}</dd></div>
        <div><dt>WORKSHOPS</dt><dd>ESAS SEMANAS</dd></div>
        <div><dt>GANADORES</dt><dd>{dates.winnersMono}</dd></div>
      </dl>
    </div>

    <div class="stage">
      <p class="chip mono"><span class="dot"></span>{chip}</p>
      <div class="stage-box">
        <div class="stack" data-stack>
          <i class="glow" aria-hidden="true"></i>
          <div class="layer l3"><Ticket ghost /></div>
          <div class="layer l2"><Ticket ghost /></div>
          <div class="layer l1" data-tilt role="img" aria-label={ticketLabel}><Ticket /></div>
        </div>
      </div>
      <div class="box">
        <p class="pill mono"><span class="dot"></span>{TICKETS_TOTAL} TICKETS · {TICKETS_TOTAL} JUJEÑOS</p>
        <ul class="seats" aria-label={`${free} de ${TICKETS_TOTAL} asientos libres`}>
          {seats.map((taken) => <li class:list={['seat', { taken }]}></li>)}
        </ul>
        <p class="legend mono">{free === TICKETS_TOTAL ? `${TICKETS_TOTAL} asientos libres` : `${free} asientos libres`}</p>
      </div>
    </div>
  </div>

  <a class="scroll mono" href="#como" aria-label="Bajar al contenido">
    <span>BAJÁ AL ANDÉN</span>
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7 1v12M2 8l5 5 5-5"/></svg>
  </a>
</section>

<script>
  import { mountFoil } from '../lib/vgpu/foil';

  const stack = document.querySelector<HTMLElement>('[data-stack]');
  const tilt = document.querySelector<HTMLElement>('[data-tilt]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Curva de la Tierra del cosmos a la altura del borde inferior del stack del ticket
  // (el ticket "flota" sobre el planeta, como en la ref).
  if (stack && tilt) {
    const fine = matchMedia('(hover: hover) and (pointer: fine)');

    // Foil WebGPU (vgpu): reemplaza al metal+holo CSS cuando hay GPU. Con reduced-motion
    // monta un frame estático. Si falla, queda el fallback CSS.
    const canvas = stack.querySelector<HTMLCanvasElement>('[data-foil-gl]');
    if (canvas) {
      const body = canvas.closest('[data-body]');
      mountFoil(canvas, {
        host: stack,
        reducedMotion: reduced,
        onFail: () => body?.classList.remove('gl-on'),
      })
        .then(() => body?.classList.add('gl-on'))
        .catch(() => {});
    }

    if (!reduced) {
      const set = (rx: number, ry: number, sheen: number) => {
        stack.style.setProperty('--rx', `${rx}deg`);
        stack.style.setProperty('--ry', `${ry}deg`);
        stack.style.setProperty('--sheen', String(sheen));
      };
      stack.addEventListener('pointermove', (e) => {
        if (!fine.matches) return;
        const r = stack.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        stack.classList.add('is-hover');
        set(-py * 14, px * 18, 18 + (px + 0.5) * 70);
      });
      stack.addEventListener('pointerleave', () => {
        stack.classList.remove('is-hover');
        set(0, 0, 18);
      });
      // Sheen CSS al entrar en viewport (una pasada) para el fallback sin WebGPU
      new IntersectionObserver(
        (entries, obs) => {
          for (const en of entries)
            if (en.isIntersecting) {
              stack.classList.add('sweep');
              obs.disconnect();
            }
        },
        { threshold: 0.4 },
      ).observe(stack);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background: var(--cosmos-950);
    overflow: hidden;
    isolation: isolate;
    padding: var(--sp-8) 0 var(--sp-16);
  }

  /* ───────── Cosmos + Quebrada (foto entera, sin scale() que la pixela) ───────── */
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(42% 36% at 82% 12%, rgba(48, 78, 150, 0.55), transparent 70%),
      radial-gradient(28% 24% at 14% 0%, rgba(255, 122, 42, 0.16), transparent 72%),
      linear-gradient(180deg, #05070d 0%, #070b16 38%, #120e14 72%, #05070d 100%);
  }
  .stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1.2px 1.2px at 12% 18%, rgba(255, 255, 255, 0.9), transparent 60%),
      radial-gradient(1px 1px at 38% 9%, rgba(255, 255, 255, 0.7), transparent 60%),
      radial-gradient(1.4px 1.4px at 61% 22%, rgba(255, 255, 255, 0.8), transparent 60%),
      radial-gradient(1px 1px at 83% 14%, rgba(255, 255, 255, 0.6), transparent 60%),
      radial-gradient(1px 1px at 27% 41%, rgba(255, 255, 255, 0.55), transparent 60%),
      radial-gradient(1.3px 1.3px at 72% 37%, rgba(255, 255, 255, 0.7), transparent 60%),
      radial-gradient(1px 1px at 93% 48%, rgba(255, 255, 255, 0.5), transparent 60%),
      radial-gradient(1px 1px at 49% 55%, rgba(255, 255, 255, 0.45), transparent 60%);
    background-size: 420px 320px;
    opacity: 0.8;
    mask-image: linear-gradient(180deg, #000 0, #000 48%, transparent 78%);
  }
  /* Cielo del poster, a su tamaño (1024). El mask funde el borde; no hay scale(3). */
  .cosmos {
    position: absolute;
    top: 0;
    right: 0;
    width: min(640px, 52vw);
    height: auto;
    opacity: 0.9;
    mask-image:
      linear-gradient(90deg, transparent 0%, #000 24%),
      linear-gradient(180deg, #000 0%, #000 46%, transparent 100%);
    mask-composite: intersect;
  }
  /* Tren en la Quebrada: anclado a la derecha, altura nativa relativa, sin estirar. */
  .quebrada {
    position: absolute;
    right: -2%;
    bottom: 0;
    width: min(1040px, 70vw);
    height: auto;
    max-height: 86%;
    object-fit: cover;
    object-position: 62% 68%;
    filter: saturate(1.08) contrast(1.06);
    mask-image:
      linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.55) 18%, #000 42%),
      linear-gradient(180deg, transparent 0%, #000 18%, #000 72%, transparent 100%);
    mask-composite: intersect;
  }
  .flare {
    position: absolute;
    right: 12%;
    bottom: 16%;
    width: min(520px, 46vw);
    height: 220px;
    background: radial-gradient(closest-side, rgba(255, 140, 60, 0.5), rgba(255, 90, 31, 0.12) 46%, transparent 72%);
    filter: blur(6px);
    mix-blend-mode: screen;
  }
  .navy {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(5, 7, 13, 0.94) 0%, rgba(5, 7, 13, 0.62) 28%, rgba(5, 7, 13, 0.08) 56%, rgba(5, 7, 13, 0.22) 100%),
      linear-gradient(180deg, rgba(5, 7, 13, 0.45) 0%, rgba(5, 7, 13, 0) 18%, rgba(5, 7, 13, 0) 68%, rgba(5, 7, 13, 0.82) 100%);
  }
  .grain {
    position: absolute;
    inset: 0;
    opacity: 0.16;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='2'/></filter><rect width='200' height='200' filter='url(%23n)'/></svg>");
  }
  .shard {
    position: absolute;
    background: var(--orange-500);
  }
  .shard-tl {
    left: 0;
    top: 0;
    width: 180px;
    height: 120px;
    clip-path: polygon(0 0, 100% 0, 0 55%);
    opacity: 0.95;
  }
  .shard-br {
    right: 0;
    bottom: 0;
    width: 260px;
    height: 180px;
    clip-path: polygon(100% 25%, 100% 100%, 30% 100%);
    opacity: 0.9;
  }
  .rail {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 0;
    border-top: 2px dotted rgba(255, 122, 42, 0.55);
  }

  /* ───────── Layout ───────── */
  .wrap {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--sp-4) var(--gutter) 0;
    display: grid;
    gap: var(--sp-10, 40px);
    flex: 1;
  }
  .mono {
    font-family: var(--font-mono);
  }
  h1 {
    margin: 0;
    font: 900 var(--fs-hero) / var(--lh-hero) var(--font-display);
    text-transform: uppercase;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--white);
  }
  .vos {
    color: var(--white);
    -webkit-text-fill-color: var(--white);
    text-shadow: 0 8px 32px rgba(5, 7, 13, 0.75);
  }
  /* Única lámina de letras de la página: la pregunta, no "Y vos…". */
  .foil {
    background-image:
      linear-gradient(
        115deg,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0) 42%,
        rgba(255, 255, 255, 0.95) 50%,
        rgba(255, 255, 255, 0) 58%,
        rgba(255, 255, 255, 0) 100%
      ),
      linear-gradient(
        100deg,
        #fff4e4 0%,
        #ffb15a 9%,
        #fff 16%,
        #49c4ff 28%,
        #d9a6ff 40%,
        #ff6ec7 50%,
        #fff 58%,
        #ffe08a 68%,
        #5dffe0 80%,
        #ff8a3d 90%,
        #fff4e4 100%
      );
    background-size: 280% 100%, 150% 100%;
    background-position: 80% 50%, 0% 50%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 10px 28px rgba(5, 7, 13, 0.55));
    animation: foil-letters 2.8s linear infinite;
  }
  @keyframes foil-letters {
    from { background-position: 130% 50%, 0% 50%; }
    to { background-position: -30% 50%, 100% 50%; }
  }
  .lead {
    margin: var(--sp-6) 0 0;
    max-width: 44ch;
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: rgba(255, 255, 255, 0.82);
    text-shadow: 0 2px 16px rgba(6, 15, 34, 0.8);
  }
  .ctas {
    margin-top: var(--sp-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    padding: 16px 28px;
    border-radius: var(--r-sm);
    font: 600 16px/1.2 var(--font-text);
    text-decoration: none;
    transition:
      background var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .cta-primary {
    background: var(--orange-500);
    color: var(--navy-900);
    box-shadow: var(--shadow-cta);
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%);
    border-radius: 0;
  }
  .cta-primary:hover {
    background: var(--orange-400);
    box-shadow: var(--shadow-cta-hover);
  }
  .cta-primary:active {
    background: var(--orange-600);
  }
  .arrow {
    transition: transform var(--dur-base) var(--ease-out);
  }
  .cta-primary:hover .arrow {
    transform: translateX(4px);
  }
  .cta-closed {
    background: rgba(18, 43, 85, 0.75);
    color: rgba(255, 255, 255, 0.64);
    cursor: default;
  }
  .cta-secondary {
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: var(--white);
    background: rgba(6, 15, 34, 0.35);
    backdrop-filter: blur(8px);
  }
  .cta-secondary:hover {
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.08);
  }
  .facts {
    margin: var(--sp-8) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4) var(--sp-6);
    font-size: 11px;
    letter-spacing: 0.1em;
  }
  .facts div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-left: var(--sp-3);
    border-left: 2px solid var(--orange-500);
  }
  .facts dt {
    color: rgba(255, 255, 255, 0.55);
  }
  .facts dd {
    margin: 0;
    color: var(--white);
    font-weight: 700;
  }

  /* ───────── Escenario del ticket ───────── */
  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-6);
    padding-top: var(--sp-6);
  }
  .chip,
  .pill {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .chip {
    padding: 6px 12px;
    border: 1px solid var(--orange-500);
    border-radius: var(--r-pill);
    color: var(--orange-300);
    background: rgba(6, 15, 34, 0.55);
    backdrop-filter: blur(8px);
  }
  .pill {
    padding: 10px 18px;
    border-radius: var(--r-pill);
    background: rgba(17, 23, 38, 0.9);
    border: var(--border);
    font-weight: 700;
    color: var(--white);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--orange-500);
  }
  @keyframes ping {
    50% {
      opacity: 0.3;
      transform: scale(0.8);
    }
  }

  .stage-box {
    --s: 1;
    width: calc(340px * var(--s));
    height: calc(620px * var(--s));
    max-width: 100%;
  }
  .stack {
    --rx: 0deg;
    --ry: 0deg;
    --sheen: 18;
    position: relative;
    width: 340px;
    height: 620px;
    transform: scale(var(--s));
    transform-origin: top left;
    perspective: 1400px;
  }
  .glow {
    position: absolute;
    inset: 10% 6%;
    border-radius: 50%;
    /* Halo plateado: el metal del ticket ilumina el andén, no otro naranja */
    background: radial-gradient(closest-side, rgba(214, 222, 236, 0.3), rgba(214, 222, 236, 0) 72%);
    filter: blur(30px);
    z-index: 0;
  }
  .layer {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .l2,
  .l3 {
    display: none;
  }
  .l1 {
    z-index: 2;
    filter: drop-shadow(0 30px 40px rgba(6, 15, 34, 0.75)) drop-shadow(0 0 28px rgba(255, 90, 31, 0.22));
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition:
      transform var(--dur-base) var(--ease-out),
      filter var(--dur-base) var(--ease-out);
    animation: float 7s ease-in-out infinite;
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotateX(var(--rx)) rotateY(var(--ry));
    }
    50% {
      transform: translateY(-12px) rotateX(calc(var(--rx) + 2deg)) rotateY(calc(var(--ry) - 3deg));
    }
  }
  .stack.sweep :global(.foil) {
    animation: sweep 1.6s var(--ease-out) 1 forwards;
  }
  @keyframes sweep {
    from {
      background-position: 0% 0;
    }
    to {
      background-position: 100% 0;
    }
  }

  .box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
  }
  .seats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 10px);
    gap: 4px;
  }
  .seat {
    width: 10px;
    height: 10px;
    border-radius: var(--r-xs);
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(6, 15, 34, 0.5);
  }
  .seat.taken {
    background: var(--orange-500);
    border-color: var(--orange-500);
    box-shadow: 0 0 8px rgba(255, 90, 31, 0.6);
  }
  .legend {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .scroll {
    position: relative;
    z-index: 1;
    display: none;
    align-items: center;
    gap: var(--sp-2);
    margin: var(--sp-8) auto 0;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
  }
  .scroll:hover {
    color: var(--orange-300);
  }
  .scroll svg {
    animation: nudge 2s ease-in-out infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateY(4px);
    }
  }

  /* ───────── Tablet ───────── */
  @media (min-width: 768px) {
    .hero {
      padding-top: var(--sp-12);
    }
    .wrap {
      padding-top: var(--sp-8);
    }
    .scroll {
      display: inline-flex;
    }
  }

  /* ───────── Desktop: tren detrás, ticket horizontal flotando delante ───────── */
  @media (min-width: 1024px) {
    .hero {
      padding-top: var(--sp-8);
      padding-bottom: var(--sp-12);
    }
    .cosmos {
      width: min(720px, 46vw);
    }
    .quebrada {
      width: min(1180px, 62vw);
      max-height: 92%;
      right: 0;
    }
    .wrap {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: var(--sp-8);
      padding-top: var(--sp-12);
      max-width: 1440px;
    }
    .copy {
      padding-bottom: var(--sp-8);
    }
    h1 {
      font-size: clamp(44px, 4.4vw, 64px);
    }
    .stage {
      align-items: flex-end;
      gap: var(--sp-5, 20px);
      padding-top: 0;
    }
    .stage-box {
      --s: 0.56;
      width: calc(880px * var(--s));
      height: calc(320px * var(--s) + 56px);
      margin: var(--sp-6) 0 0;
    }
    .stack {
      width: 880px;
      height: 320px;
    }
    .glow {
      inset: -10% 5% -30%;
    }
    .l2,
    .l3 {
      display: block;
    }
    .l2 {
      transform: rotate(-6deg) translate(-28px, 26px);
      opacity: 0.55;
      filter: blur(0.5px);
    }
    .l3 {
      transform: rotate(4deg) translate(26px, 48px);
      opacity: 0.3;
      filter: blur(1px);
    }
    .l1 {
      transform: rotateX(calc(var(--rx) + 6deg)) rotateY(calc(var(--ry) - 8deg));
    }
    @keyframes float {
      0%,
      100% {
        transform: translateY(0) rotateX(calc(var(--rx) + 6deg)) rotateY(calc(var(--ry) - 8deg));
