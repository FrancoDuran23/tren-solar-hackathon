---
import Ticket from './Ticket.astro';
import { config, TICKETS_TOTAL } from '../config';

const isOpen = config.registration === 'open' && !!config.lumaUrl;
const isClosed = config.registration === 'closed';
const state: 'open' | 'closed' | 'soon' = isClosed ? 'closed' : isOpen ? 'open' : 'soon';

const chip = state === 'open' ? 'Inscripción abierta' : '35 tickets en juego';
const assigned = Math.min(Math.max(config.ticketsAssigned, 0), TICKETS_TOTAL);
const free = TICKETS_TOTAL - assigned;
const seats = Array.from({ length: TICKETS_TOTAL }, (_, i) => i < assigned);
const ticketLabel = 'Ticket Pre-Hackatón jujuy.dev, número por asignar de ' + TICKETS_TOTAL;
/* Ambiente muy sutil detrás del tren 3D (y fallback si WebGL falla) */
const ambient = '/brand/solar-train-quebrada.jpg';
const deadline = config.deadline
  ? new Date(config.deadline.iso).toLocaleDateString('es-AR')
  : 'por confirmar';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <!-- Andén: Tren Solar 3D procedural (three.js, src/lib/three/solar-train.ts) a pantalla completa, detrás del ticket -->
  <div class="backdrop" aria-hidden="true" data-backdrop>
    <img class="ambient" src={ambient} alt="" width="1024" height="775" loading="lazy" decoding="async" />
    <i class="veil veil-x"></i>
    <i class="veil veil-y"></i>
    <canvas class="train3d" data-train3d></canvas>
    <i class="grain"></i>
    <i class="shard shard-tl"></i>
    <i class="shard shard-br"></i>
    <i class="rail"></i>
  </div>

  <div class="wrap">
    <div class="copy">
      <p class="eyebrow mono">
        <img src="/brand/jujuydev-logo-white.webp" alt="" width="443" height="120" decoding="async" />
        PRESENTA · PRE-HACKATÓN ONLINE
      </p>
      <h1 id="hero-title">Y vos… <span class="q">¿te ganás<br />tu ticket?</span></h1>
      <p class="lead">
        35 tickets a la Solar Train Hackathon. Buildeá online, subí tu proyecto y subite al tren.
      </p>
      <div class="ctas">
        {state === 'open' && (
          <a class="cta cta-primary" href={config.lumaUrl!} target="_blank" rel="noopener noreferrer">
            Inscribite en Luma <span class="arrow" aria-hidden="true">→</span>
          </a>
        )}
        {state === 'soon' && (
          <span class="cta cta-soon" role="link" aria-disabled="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><path d="M8 4.5V8l2.5 1.5"/></svg>
            Inscripción abre pronto
          </span>
        )}
        {state === 'closed' && (
          <span class="cta cta-closed" role="link" aria-disabled="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1"/><path d="M5 7V5a3 3 0 0 1 6 0v2"/></svg>
            Inscripción cerrada
          </span>
        )}
        {state === 'closed'
          ? <a class="cta cta-secondary" href="#proyectos">Ver proyectos</a>
          : <a class="cta cta-secondary" href="#como">Ver cómo funciona</a>}
      </div>
      <dl class="facts mono">
        <div><dt>FORMATO</dt><dd>ONLINE</dd></div>
        <div><dt>ANDÉN</dt><dd>JUJUY · ARG</dd></div>
        <div><dt>CIERRE</dt><dd>{deadline.toUpperCase()}</dd></div>
      </dl>
    </div>

    <div class="stage">
      <p class="chip mono"><span class="dot"></span>{chip}</p>
      <div class="stage-box">
        <div class="stack" data-stack>
          <i class="glow" aria-hidden="true"></i>
          <div class="layer l3"><Ticket ghost /></div>
          <div class="layer l2"><Ticket ghost /></div>
          <div class="layer l1" data-tilt role="img" aria-label={ticketLabel}><Ticket /></div>
        </div>
      </div>
      <div class="box">
        <p class="pill mono"><span class="dot"></span>35 TICKETS · 35 JUJEÑOS</p>
        <ul class="seats" aria-label={`${free} de ${TICKETS_TOTAL} asientos libres`}>
          {seats.map((taken) => <li class:list={['seat', { taken }]}></li>)}
        </ul>
        <p class="legend mono">{free === TICKETS_TOTAL ? '35 asientos libres' : `${free} asientos libres`}</p>
      </div>
    </div>
  </div>

  <a class="scroll mono" href="#como" aria-label="Bajar al contenido">
    <span>BAJÁ AL ANDÉN</span>
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7 1v12M2 8l5 5 5-5"/></svg>
  </a>
</section>

<script>
  import { mountFoil } from '../lib/vgpu/foil';

  const stack = document.querySelector<HTMLElement>('[data-stack]');
  const tilt = document.querySelector<HTMLElement>('[data-tilt]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Tren Solar 3D detrás del ticket. three.js va en su propio chunk (import dinámico);
  // si no hay WebGL o el GLB falla, queda la foto ambiente un poco más visible.
  const backdrop = document.querySelector<HTMLElement>('[data-backdrop]');
  const train = backdrop?.querySelector<HTMLCanvasElement>('[data-train3d]');
  const hero = document.querySelector<HTMLElement>('.hero');
  if (backdrop && train) {
    const probe = document.createElement('canvas');
    const gl = probe.getContext('webgl2') ?? probe.getContext('webgl');
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    if (gl && !saveData) {
      import('../lib/three/train')
        .then(({ mountTrain }) =>
          mountTrain(train, {
            reducedMotion: reduced,
            host: hero ?? backdrop,
            ...(stack ? { anchor: stack } : {}),
          }),
        )
        .then(() => backdrop.classList.add('gl-on'))
        .catch((err: unknown) => {
          console.warn('[train3d] fallback a foto ambiente:', err);
          backdrop.classList.add('gl-off');
        });
    } else {
      backdrop.classList.add('gl-off');
    }
  }

  if (stack && tilt) {
    const fine = matchMedia('(hover: hover) and (pointer: fine)');

    // Foil WebGPU (vgpu): reemplaza al metal+holo CSS cuando hay GPU. Con reduced-motion
    // monta un frame estático. Si falla, queda el fallback CSS.
    const canvas = stack.querySelector<HTMLCanvasElement>('[data-foil-gl]');
    if (canvas) {
      const body = canvas.closest('[data-body]');
      mountFoil(canvas, {
        host: stack,
        reducedMotion: reduced,
        onFail: () => body?.classList.remove('gl-on'),
      })
        .then(() => body?.classList.add('gl-on'))
        .catch(() => {});
    }

    if (!reduced) {
      const set = (rx: number, ry: number, sheen: number) => {
        stack.style.setProperty('--rx', `${rx}deg`);
        stack.style.setProperty('--ry', `${ry}deg`);
        stack.style.setProperty('--sheen', String(sheen));
      };
      stack.addEventListener('pointermove', (e) => {
        if (!fine.matches) return;
        const r = stack.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        stack.classList.add('is-hover');
        set(-py * 14, px * 18, 18 + (px + 0.5) * 70);
      });
      stack.addEventListener('pointerleave', () => {
        stack.classList.remove('is-hover');
        set(0, 0, 18);
      });
      // Sheen CSS al entrar en viewport (una pasada) para el fallback sin WebGPU
      new IntersectionObserver(
        (entries, obs) => {
          for (const en of entries)
            if (en.isIntersecting) {
              stack.classList.add('sweep');
              obs.disconnect();
            }
        },
        { threshold: 0.4 },
      ).observe(stack);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background: var(--navy-950);
    overflow: hidden;
    isolation: isolate;
    padding: var(--sp-8) 0 var(--sp-16);
  }

  /* ───────── Andén / tren ───────── */
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .ambient {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 38%;
    opacity: 0.55;
    filter: saturate(0.9) blur(2px);
    transition: opacity 900ms var(--ease-out);
  }
  .backdrop.gl-on .ambient {
    opacity: 0.22;
  }
  .train3d {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
    mask-image: linear-gradient(180deg, transparent 0, #000 8%, #000 92%, transparent 100%);
  }
  .backdrop.gl-on .train3d {
    opacity: 1;
  }
  .backdrop.gl-off .train3d {
    display: none;
  }
  .veil {
    position: absolute;
    inset: 0;
  }
  .veil-x {
    background: linear-gradient(
      90deg,
      rgba(6, 15, 34, 0.92) 0%,
      rgba(6, 15, 34, 0.7) 38%,
      rgba(6, 15, 34, 0.25) 68%,
      rgba(6, 15, 34, 0.45) 100%
    );
  }
  .veil-y {
    background: linear-gradient(
      180deg,
      rgba(6, 15, 34, 0.85) 0%,
      rgba(6, 15, 34, 0.15) 22%,
      rgba(6, 15, 34, 0) 50%,
      rgba(6, 15, 34, 0.75) 82%,
      var(--navy-950) 100%
    );
  }
  .grain {
    position: absolute;
    inset: 0;
    opacity: 0.1;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='2'/></filter><rect width='200' height='200' filter='url(%23n)'/></svg>");
  }
  .shard {
    position: absolute;
    background: var(--orange-500);
  }
  .shard-tl {
    left: 0;
    top: 0;
    width: 180px;
    height: 120px;
    clip-path: polygon(0 0, 100% 0, 0 55%);
    opacity: 0.95;
  }
  .shard-br {
    right: 0;
    bottom: 0;
    width: 260px;
    height: 180px;
    clip-path: polygon(100% 25%, 100% 100%, 30% 100%);
    opacity: 0.9;
  }
  .rail {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 0;
    border-top: 2px dotted rgba(255, 122, 42, 0.55);
  }

  /* ───────── Layout ───────── */
  .wrap {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--sp-4) var(--gutter) 0;
    display: grid;
    gap: var(--sp-10, 40px);
    flex: 1;
  }
  .mono {
    font-family: var(--font-mono);
  }
  .eyebrow {
    margin: 0 0 var(--sp-4);
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--orange-300);
  }
  .eyebrow img {
    height: 18px;
    width: auto;
    border-radius: 4px;
  }
  h1 {
    margin: 0;
    font: 900 var(--fs-hero) / var(--lh-hero) var(--font-display);
    letter-spacing: -0.03em;
    text-wrap: balance;
    text-shadow: 0 8px 40px rgba(6, 15, 34, 0.7);
  }
  h1 .q {
    display: block;
    color: var(--white);
    background: linear-gradient(90deg, #fff 0%, #fff 55%, var(--orange-300) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .lead {
    margin: var(--sp-6) 0 0;
    max-width: 44ch;
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: rgba(255, 255, 255, 0.82);
    text-shadow: 0 2px 16px rgba(6, 15, 34, 0.8);
  }
  .ctas {
    margin-top: var(--sp-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    padding: 16px 28px;
    border-radius: var(--r-sm);
    font: 600 16px/1.2 var(--font-text);
    text-decoration: none;
    transition:
      background var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .cta-primary {
    background: var(--orange-500);
    color: var(--navy-900);
    box-shadow: var(--shadow-cta);
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%);
    border-radius: 0;
  }
  .cta-primary:hover {
    background: var(--orange-400);
    box-shadow: var(--shadow-cta-hover);
  }
  .cta-primary:active {
    background: var(--orange-600);
  }
  .arrow {
    transition: transform var(--dur-base) var(--ease-out);
  }
  .cta-primary:hover .arrow {
    transform: translateX(4px);
  }
  .cta-soon {
    background: rgba(18, 43, 85, 0.75);
    backdrop-filter: blur(8px);
    border: 1px dashed var(--orange-500);
    color: rgba(255, 255, 255, 0.8);
    cursor: default;
  }
  .cta-closed {
    background: rgba(18, 43, 85, 0.75);
    color: rgba(255, 255, 255, 0.64);
    cursor: default;
  }
  .cta-secondary {
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: var(--white);
    background: rgba(6, 15, 34, 0.35);
    backdrop-filter: blur(8px);
  }
  .cta-secondary:hover {
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.08);
  }
  .facts {
    margin: var(--sp-8) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4) var(--sp-6);
    font-size: 11px;
    letter-spacing: 0.1em;
  }
  .facts div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-left: var(--sp-3);
    border-left: 2px solid var(--orange-500);
  }
  .facts dt {
    color: rgba(255, 255, 255, 0.55);
  }
  .facts dd {
    margin: 0;
    color: var(--white);
    font-weight: 700;
  }

  /* ───────── Escenario del ticket ───────── */
  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-6);
  }
  .chip,
  .pill {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .chip {
    padding: 6px 12px;
    border: 1px solid var(--orange-500);
    border-radius: var(--r-pill);
    color: var(--orange-300);
    background: rgba(6, 15, 34, 0.55);
    backdrop-filter: blur(8px);
  }
  .pill {
    padding: 10px 18px;
    border-radius: var(--r-pill);
    background: rgba(18, 43, 85, 0.85);
    border: var(--border);
    font-weight: 700;
    color: var(--white);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--orange-500);
    box-shadow: 0 0 12px var(--orange-500);
    animation: ping 1.6s ease-in-out infinite;
  }
  @keyframes ping {
    50% {
      opacity: 0.3;
      transform: scale(0.8);
    }
  }

  .stage-box {
    --s: 1;
    width: calc(340px * var(--s));
    height: calc(620px * var(--s));
    max-width: 100%;
  }
  .stack {
    --rx: 0deg;
    --ry: 0deg;
    --sheen: 18;
    position: relative;
    width: 340px;
    height: 620px;
    transform: scale(var(--s));
    transform-origin: top left;
    perspective: 1400px;
  }
  .glow {
    position: absolute;
    inset: 10% 6%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 122, 42, 0.45), rgba(255, 90, 31, 0) 70%);
    filter: blur(30px);
    z-index: 0;
    animation: glow 7s ease-in-out infinite;
  }
  @keyframes glow {
    50% {
      opacity: 0.6;
      transform: scale(1.06);
    }
  }
  .layer {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .l2,
  .l3 {
    display: none;
  }
  .l1 {
    z-index: 2;
    filter: drop-shadow(0 30px 40px rgba(6, 15, 34, 0.75)) drop-shadow(0 0 28px rgba(255, 90, 31, 0.22));
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition:
      transform var(--dur-base) var(--ease-out),
      filter var(--dur-base) var(--ease-out);
    animation: float 7s ease-in-out infinite;
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotateX(var(--rx)) rotateY(var(--ry));
    }
    50% {
      transform: translateY(-12px) rotateX(calc(var(--rx) + 2deg)) rotateY(calc(var(--ry) - 3deg));
    }
  }
  .stack.sweep :global(.foil) {
    animation: sweep 1.6s var(--ease-out) 1 forwards;
  }
  @keyframes sweep {
    from {
      background-position: 0% 0;
    }
    to {
      background-position: 100% 0;
    }
  }

  .box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
  }
  .seats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(7, 10px);
    gap: 4px;
  }
  .seat {
    width: 10px;
    height: 10px;
    border-radius: var(--r-xs);
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(6, 15, 34, 0.5);
  }
  .seat.taken {
    background: var(--orange-500);
    border-color: var(--orange-500);
    box-shadow: 0 0 8px rgba(255, 90, 31, 0.6);
  }
  .legend {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .scroll {
    position: relative;
    z-index: 1;
    display: none;
    align-items: center;
    gap: var(--sp-2);
    margin: var(--sp-8) auto 0;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
  }
  .scroll:hover {
    color: var(--orange-300);
  }
  .scroll svg {
    animation: nudge 2s ease-in-out infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateY(4px);
    }
  }

  /* ───────── Tablet ───────── */
  @media (min-width: 768px) {
    .hero {
      padding-top: var(--sp-12);
    }
    .wrap {
      padding-top: var(--sp-8);
    }
    .scroll {
      display: inline-flex;
    }
  }

  /* ───────── Desktop: tren detrás, ticket horizontal flotando delante ───────── */
  @media (min-width: 1024px) {
    .hero {
      padding-top: var(--sp-8);
      padding-bottom: var(--sp-12);
    }
    .ambient {
      object-position: 62% 42%;
    }
    .train3d {
      mask-image:
        linear-gradient(180deg, transparent 0, #000 8%, #000 92%, transparent 100%),
        linear-gradient(90deg, transparent 0, #000 22%, #000 100%);
      mask-composite: intersect;
    }
    .veil-x {
      background: linear-gradient(
        90deg,
        rgba(6, 15, 34, 0.96) 0%,
        rgba(6, 15, 34, 0.82) 30%,
        rgba(6, 15, 34, 0.3) 55%,
        rgba(6, 15, 34, 0.05) 78%,
        rgba(6, 15, 34, 0.35) 100%
      );
    }
    .wrap {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: var(--sp-8);
      padding-top: var(--sp-12);
      max-width: 1440px;
    }
    .copy {
      padding-bottom: var(--sp-8);
    }
    h1 {
      font-size: clamp(56px, 6vw, 84px);
    }
    .stage {
      align-items: flex-end;
      gap: var(--sp-5, 20px);
    }
    .stage-box {
      --s: 0.56;
      width: calc(880px * var(--s));
      height: calc(320px * var(--s) + 56px);
      margin: var(--sp-6) 0 0;
    }
    .stack {
      width: 880px;
      height: 320px;
    }
    .glow {
      inset: -10% 5% -30%;
    }
    .l2,
    .l3 {
      display: block;
    }
    .l2 {
      transform: rotate(-6deg) translate(-28px, 26px);
      opacity: 0.55;
      filter: blur(0.5px);
    }
    .l3 {
      transform: rotate(4deg) translate(26px, 48px);
      opacity: 0.3;
      filter: blur(1px);
    }
    .l1 {
      transform: rotateX(calc(var(--rx) + 6deg)) rotateY(calc(var(--ry) - 8deg));
    }
    @keyframes float {
      0%,
      100% {
        transform: translateY(0) rotateX(calc(var(--rx) + 6deg)) rotateY(calc(var(--ry) - 8deg));
      }
      50% {
        transform: translateY(-14px) rotateX(calc(var(--rx) + 8deg)) rotateY(calc(var(--ry) - 11deg));
      }
    }
    .stack.is-hover .l1 {
      animation: none;
      transform: rotateX(var(--rx)) rotateY(var(--ry));
      filter: drop-shadow(0 44px 56px rgba(6, 15, 34, 0.8)) drop-shadow(0 0 40px rgba(255, 90, 31, 0.3));
    }
    .box {
      align-items: flex-end;
    }
    .seats {
      grid-template-columns: repeat(35, 10px);
    }
  }
  @media (min-width: 1280px) {
    .stage-box {
      --s: 0.74;
