---
import { sections } from '../content/sections';

const c = sections.sponsor;
---

<section class="sp" id="sponsor" aria-labelledby="sp-title">
  <div class="wrap">
    <article class="card">
      <i class="laminate" aria-hidden="true"></i>
      <div class="copy">
        <p class="chip mono">{c.chip}</p>
        <h2 id="sp-title">{c.title}</h2>
        <p class="text">{c.text}</p>
        <p class="soon mono">{c.soon}</p>
      </div>

      <aside class="stub" aria-label="Sobre sellado del sponsor">
        <p class="stub-kicker mono">SOBRE SELLADO</p>
        <dl class="rows mono">
          {c.rows.map((row) => (
            <div>
              <dt>{row.k}</dt>
              <dd>{row.v}</dd>
            </div>
          ))}
        </dl>
        <p class="seal" aria-hidden="true">
          <span>···</span>
        </p>
        <i class="stub-laminate" aria-hidden="true"></i>
      </aside>
    </article>
  </div>
</section>

<style>
  .sp {
    background: var(--cosmos-950);
    padding: var(--sp-16) 0;
    border-top: 1px solid var(--edge);
  }
  .wrap {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .card {
    position: relative;
    display: grid;
    gap: var(--sp-8);
    align-items: stretch;
    padding: var(--sp-8);
    color: var(--white);
    background:
      linear-gradient(180deg, rgba(214, 222, 236, 0.05), transparent 28%),
      linear-gradient(180deg, #121826 0%, #0b0e16 100%);
    clip-path: polygon(
      16px 0, calc(100% - 16px) 0, 100% 16px,
      100% calc(100% - 16px), calc(100% - 16px) 100%,
      16px 100%, 0 calc(100% - 16px), 0 16px
    );
    box-shadow:
      inset 0 0 0 1px var(--edge-strong),
      0 28px 56px rgba(0, 0, 0, 0.35);
  }
  .laminate {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 4px;
    background: var(--holo);
  }
  .copy {
    min-width: 0;
  }
  .chip {
    display: inline-block;
    margin: 0 0 var(--sp-4);
    padding: 6px 12px;
    border: 1px solid var(--orange-500);
    color: var(--orange-300);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  .mono {
    font-family: var(--font-mono);
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(32px, 4vw, 52px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 0 0 var(--sp-4);
    color: var(--white);
    max-width: 14ch;
  }
  .text {
    color: var(--text-muted);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    max-width: 42ch;
    margin: 0;
  }
  .soon {
    margin: var(--sp-6) 0 0;
    color: var(--orange-300);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .stub {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--sp-4);
    margin: 0;
    padding: var(--sp-6) var(--sp-6) 28px;
    background: #0b0e16;
    border: 1px solid var(--edge-strong);
    clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
    overflow: hidden;
  }
  .stub-kicker {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--white);
  }
  .rows {
    margin: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--edge);
  }
  .rows div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--sp-3);
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid var(--edge);
  }
  dt {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.5);
  }
  dd {
    margin: 0;
    font: 700 16px/1.2 var(--font-display);
    letter-spacing: 0.04em;
    color: var(--white);
  }
  .seal {
    margin: var(--sp-2) 0 0;
    width: 72px;
    height: 72px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px dashed rgba(214, 222, 236, 0.55);
    color: var(--silver);
    font-family: var(--font-mono);
    letter-spacing: 0.2em;
  }
  .stub-laminate {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 10px;
    background: var(--holo);
  }
  @media (min-width: 860px) {
    .sp {
      padding: var(--sp-24) 0;
    }
    .card {
      grid-template-columns: 1.35fr 0.9fr;
      gap: var(--sp-12);
      padding: var(--sp-12);
    }
    .stub {
      align-self: stretch;
    }
  }
</style>
