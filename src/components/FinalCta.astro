---
import Cta from './Cta.astro';
import { sections } from '../content/sections';
import { TICKETS_TOTAL } from '../config';

const c = sections.finalCta;
---

<section class="final" aria-labelledby="final-title">
  <div class="sky" aria-hidden="true">
    <img src="/brand/solar-train-sky.jpg" alt="" width="1024" height="512" loading="lazy" decoding="async" />
    <i class="veil"></i>
    <i class="sun"></i>
    <i class="rail"></i>
  </div>

  <div class="wrap">
    <div class="copy">
      <p class="eyebrow mono"><span class="dot"></span>ÚLTIMA LLAMADA · ANDÉN JUJ</p>
      <h2 id="final-title">{c.title}</h2>
      <p class="text">{c.text}</p>
      <div class="ctas">
        <Cta size="lg" />
        <a class="link mono" href="#entrega">ENTREGAR PROYECTO →</a>
      </div>
    </div>

    <!-- Stub estático del ticket: eco del hero -->
    <div class="stub" aria-hidden="true">
      <div class="stub-head mono">
        <span>ADMIT ONE</span>
        <span class="stub-brand"><img src="/brand/jujuydev-logo-white.webp" alt="" width="443" height="120" loading="lazy" decoding="async" /></span>
      </div>
      <p class="no">N° <span class="dots">··</span><span class="of">/{TICKETS_TOTAL}</span></p>
      <dl class="grid mono">
        <div><dt>VAGÓN</dt><dd>01</dd></div>
        <div><dt>ANDÉN</dt><dd>JUJ</dd></div>
        <div><dt>GATE</dt><dd>PRE</dd></div>
        <div><dt>DESTINO</dt><dd>SOLAR TRAIN</dd></div>
      </dl>
      <p class="legal mono">UNAUTHORISED RESALE PROHIBITED · VÁLIDO SOLO CON RESIDENCIA EN JUJUY</p>
      <i class="stripe"></i>
      <i class="notch n1"></i>
      <i class="notch n2"></i>
    </div>
  </div>
</section>

<style>
  .final {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--navy-950);
    padding: var(--sp-24) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .mono {
    font-family: var(--font-mono);
  }
  .sky {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .sky img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    opacity: 0.55;
  }
  .veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, var(--navy-950) 0%, rgba(6, 15, 34, 0.3) 35%, rgba(6, 15, 34, 0.55) 100%),
      linear-gradient(90deg, rgba(6, 15, 34, 0.7), rgba(6, 15, 34, 0.1));
  }
  .sun {
    position: absolute;
    right: -120px;
    bottom: -220px;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: var(--grad-sun);
    opacity: 0.5;
    filter: blur(2px);
  }
  .rail {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 0;
    border-top: 2px dotted rgba(255, 122, 42, 0.5);
  }

  .wrap {
    position: relative;
    z-index: 1;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    gap: var(--sp-12);
    align-items: center;
  }
  .eyebrow {
    margin: 0 0 var(--sp-4);
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--orange-300);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--orange-500);
    box-shadow: 0 0 12px var(--orange-500);
    animation: ping 1.6s ease-in-out infinite;
  }
  @keyframes ping {
    50% {
      opacity: 0.3;
    }
  }
  h2 {
    font: 900 clamp(44px, 7vw, 88px) / 0.95 var(--font-display);
    letter-spacing: -0.03em;
    margin: 0;
    text-wrap: balance;
  }
  .text {
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--fs-lead);
    margin: var(--sp-6) 0 0;
    max-width: 40ch;
  }
  .ctas {
    margin-top: var(--sp-8);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-6);
  }
  .link {
    color: var(--orange-400);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }
  .link:hover {
    text-decoration-thickness: 2px;
    color: var(--orange-300);
  }

  /* Stub */
  .stub {
    position: relative;
    justify-self: center;
    width: min(100%, 360px);
    background:
      repeating-linear-gradient(to bottom, transparent 0 11px, rgba(201, 205, 211, 0.5) 11px 12px),
      var(--paper);
    color: var(--ink-950);
    padding: 22px 24px 26px;
    display: grid;
    gap: 8px;
    border-radius: var(--r-md);
    clip-path: polygon(
      0 0,
      calc(100% - var(--chamfer)) 0,
      100% var(--chamfer),
      100% calc(100% - var(--chamfer)),
      calc(100% - var(--chamfer)) 100%,
      0 100%
    );
    box-shadow: var(--shadow-ticket);
    transform: rotate(-4deg);
    animation: float 8s ease-in-out infinite;
  }
  @keyframes float {
    50% {
      transform: rotate(-3deg) translateY(-8px);
    }
  }
  .stub-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }
  .stub-brand {
    display: inline-flex;
    align-items: center;
    padding: 4px 7px;
    border-radius: 3px;
    background: var(--navy-900);
    line-height: 0;
  }
  .stub-head img {
    height: 11px;
    width: auto;
    display: block;
  }
  .no {
    margin: 0;
    font: 700 56px/1 var(--font-display);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .dots {
    color: var(--orange-500);
  }
  .of {
    font-size: 0.5em;
    color: var(--ink-600);
  }
  .grid {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 16px;
  }
  .grid div {
    display: flex;
    gap: 6px;
    align-items: baseline;
  }
  dt {
    font-size: 9px;
    color: var(--ink-600);
    letter-spacing: 0.08em;
  }
  dd {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
  }
  .legal {
    margin: 4px 0 0;
    font-size: 8px;
    color: var(--ink-600);
    letter-spacing: 0.04em;
  }
  .stripe {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 6px;
    background: var(--orange-500);
  }
  .notch {
    position: absolute;
    top: 50%;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--navy-950);
    transform: translateY(-50%);
  }
  .n1 {
    left: -11px;
  }
  .n2 {
    right: -11px;
  }

  @media (min-width: 900px) {
    .wrap {
      grid-template-columns: 1.3fr 1fr;
    }
    .stub {
      justify-self: end;
      width: 380px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stub,
    .dot {
      animation: none;
    }
  }
</style>
