---
import Cta from './Cta.astro';
import { sections } from '../content/sections';
import { TICKETS_TOTAL } from '../config';

const c = sections.finalCta;
---

<section class="final" aria-labelledby="final-title">
  <div class="sky" aria-hidden="true">
    <i class="veil"></i>
    <i class="space-stars"></i>
    <i class="sun"></i>
    <i class="rail"></i>
  </div>

  <div class="wrap">
    <div class="copy">
      <h2 id="final-title">{c.title}</h2>
      <p class="text">{c.text}</p>
      <div class="ctas">
        <Cta size="lg" />
        <a class="link mono" href="#entrega">ENTREGAR PROYECTO →</a>
      </div>
    </div>

    <!-- Stub estático del ticket: eco del hero -->
    <div class="stub" aria-hidden="true">
      <div class="stub-head mono">
        <span>ADMIT ONE</span>
        <span class="stub-brand"><img src="/brand/jujuydev-logo-white.webp" alt="" width="443" height="120" loading="lazy" decoding="async" /></span>
      </div>
      <p class="no">N° <span class="dots">··</span><span class="of">/{TICKETS_TOTAL}</span></p>
      <dl class="grid mono">
        <div><dt>VAGÓN</dt><dd>01</dd></div>
        <div><dt>ANDÉN</dt><dd>JUJ</dd></div>
        <div><dt>GATE</dt><dd>HTS</dd></div>
        <div><dt>DESTINO</dt><dd>TREN SOLAR</dd></div>
      </dl>
      <p class="legal mono">UNAUTHORISED RESALE PROHIBITED · VÁLIDO SOLO CON RESIDENCIA EN JUJUY</p>
      <i class="stripe"></i>
      <i class="notch n1"></i>
      <i class="notch n2"></i>
    </div>
  </div>
</section>

<style>
  .final {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--cosmos-950);
    padding: var(--sp-24) 0;
    border-top: 1px solid var(--edge);
  }
  .mono {
    font-family: var(--font-mono);
  }
  .sky {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(50% 46% at 82% 18%, rgba(36, 62, 122, 0.32), transparent 70%),
      radial-gradient(36% 40% at 8% 100%, rgba(12, 24, 56, 0.5), transparent 72%),
      linear-gradient(180deg, #04060c 0%, #070c18 100%);
  }
  .veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(5, 7, 13, 0.28) 0%, rgba(5, 7, 13, 0.08) 42%, rgba(5, 7, 13, 0.4) 100%),
      linear-gradient(90deg, rgba(5, 7, 13, 0.42), rgba(5, 7, 13, 0.05));
  }
  .sun {
    position: absolute;
    right: -120px;
    bottom: -220px;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: var(--grad-sun);
    opacity: 0.5;
    filter: blur(2px);
  }
  .rail {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 0;
    border-top: 2px dotted rgba(255, 122, 42, 0.5);
  }

  .wrap {
    position: relative;
    z-index: 1;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    gap: var(--sp-12);
    align-items: center;
  }
  .eyebrow {
    margin: 0 0 var(--sp-4);
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--orange-300);
  }
  h2 {
    font: 900 clamp(44px, 7vw, 88px) / 0.95 var(--font-display);
    letter-spacing: -0.03em;
    margin: 0;
    text-wrap: balance;
  }
  .text {
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--fs-lead);
    margin: var(--sp-6) 0 0;
    max-width: 40ch;
  }
  .ctas {
    margin-top: var(--sp-8);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-6);
  }
  .link {
    color: var(--orange-400);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }
  .link:hover {
    text-decoration-thickness: 2px;
    color: var(--orange-300);
  }

  /* Stub */
  .stub {
    position: relative;
    justify-self: center;
    width: min(100%, 360px);
    background: linear-gradient(180deg, #11151f 0%, #0b0e16 100%);
    color: var(--white);
    padding: 22px 24px 26px;
    display: grid;
    gap: 10px;
    clip-path: polygon(
      14px 0, calc(100% - 14px) 0, 100% 14px,
      100% calc(100% - 14px), calc(100% - 14px) 100%,
      14px 100%, 0 calc(100% - 14px), 0 14px
    );
    outline: 1px solid rgba(214, 222, 236, 0.28);
    outline-offset: -1px;
    box-shadow: var(--shadow-ticket);
    transform: rotate(-4deg);
  }
  .stub-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }
  .stub-brand {
    display: inline-flex;
    align-items: center;
    padding: 4px 7px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.06);
    outline: 1px solid rgba(214, 222, 236, 0.25);
    line-height: 0;
  }
  .stub-head img {
    height: 11px;
    width: auto;
    display: block;
  }
  .no {
    margin: 0;
    font: 700 56px/1 var(--font-display);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .dots {
    color: var(--orange-500);
  }
  .of {
    font-size: 0.5em;
    color: rgba(255, 255, 255, 0.55);
  }
  .grid {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 16px;
  }
  .grid div {
    display: flex;
    gap: 6px;
    align-items: baseline;
  }
  dt {
    font-size: 9px;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.08em;
  }
  dd {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
  }
  .legal {
    margin: 4px 0 0;
    font-size: 8px;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.04em;
  }
  .stripe {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 6px;
    background: var(--orange-500);
  }
  .notch {
    position: absolute;
    top: 50%;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--cosmos-950);
    transform: translateY(-50%);
  }
  .n1 {
    left: -11px;
  }
  .n2 {
    right: -11px;
  }

  @media (min-width: 900px) {
    .wrap {
      grid-template-columns: 1.3fr 1fr;
    }
    .stub {
      justify-self: end;
      width: 380px;
    }
  }
</style>
